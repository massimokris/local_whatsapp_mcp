+
+func TestDeliveryBoundaryCannotOvertakeEarlierReceivedWork(t *testing.T) {
+	cli := &Client{Log: waLog.Noop, recvLog: waLog.Noop, nodeHandlers: map[string]nodeHandler{}}
+	var mu sync.Mutex
+	var latest events.DeliveryState
+	cli.AddEventHandler(func(evt any) {
+		if v, ok := evt.(*events.DeliveryState); ok {
+			mu.Lock()
+			latest = *v
+			mu.Unlock()
+		}
+	})
+	started, release := make(chan struct{}), make(chan struct{})
+	cli.nodeHandlers["message"] = func(context.Context, *waBinary.Node) { close(started); <-release }
+	cli.nodeHandlers["ib"] = cli.handleIB
+	queue := make(chan *waBinary.Node, 4)
+	handler := cli.makeFrameHandler(queue)
+	send := func(node waBinary.Node) {
+		body, err := waBinary.Marshal(node)
+		if err != nil {
+			t.Fatal(err)
+		}
+		handler(context.Background(), body)
+	}
+	send(waBinary.Node{Tag: "message", Attrs: waBinary.Attrs{"id": "earlier"}})
+	first := <-queue
+	finished := make(chan struct{})
+	go func() { cli.handleDeliveryNode(context.Background(), first); close(finished) }()
+	<-started
+	send(waBinary.Node{Tag: "ib", Content: []waBinary.Node{{Tag: "offline", Attrs: waBinary.Attrs{"count": "1"}}}})
+	cli.handleDeliveryNode(context.Background(), <-queue)
+	mu.Lock()
+	before := latest
+	mu.Unlock()
+	if !before.Boundary || before.Pending != 1 {
+		t.Fatalf("boundary overtook unfinished work: %+v", before)
+	}
+	close(release)
+	<-finished
+	mu.Lock()
+	after := latest
+	mu.Unlock()
+	if !after.Boundary || after.Pending != 0 {
+		t.Fatalf("completed work did not settle boundary: %+v", after)
+	}
+}
+func TestDeliveryEmptyBacklogAndNewConnection(t *testing.T) {
+	cli := &Client{Log: waLog.Noop, recvLog: waLog.Noop, nodeHandlers: map[string]nodeHandler{}}
+	var states []events.DeliveryState
+	cli.AddEventHandler(func(evt any) {
+		if v, ok := evt.(*events.DeliveryState); ok {
+			states = append(states, *v)
+		}
+	})
+	cli.nodeHandlers["ib"] = cli.handleIB
+	queue := make(chan *waBinary.Node, 1)
+	handler := cli.makeFrameHandler(queue)
+	body, _ := waBinary.Marshal(waBinary.Node{Tag: "ib", Content: []waBinary.Node{{Tag: "offline", Attrs: waBinary.Attrs{"count": "0"}}}})
+	handler(context.Background(), body)
+	cli.handleDeliveryNode(context.Background(), <-queue)
+	last := states[len(states)-1]
+	if last.ConnectionID != 1 || !last.Boundary || last.Pending != 0 {
+		t.Fatalf("empty backlog not completed: %+v", last)
+	}
+	cli.makeFrameHandler(queue)
+	last = states[len(states)-1]
+	if last.ConnectionID != 2 || last.Boundary {
+		t.Fatalf("new connection retained stale boundary: %+v", last)
+	}
+}
+
+func TestDeliveryMalformedFrameRemainsFailedAtBoundary(t *testing.T) {
+	cli := &Client{Log: waLog.Noop, recvLog: waLog.Noop, nodeHandlers: map[string]nodeHandler{}}
+	var latest events.DeliveryState
+	cli.AddEventHandler(func(evt any) {
+		if v, ok := evt.(*events.DeliveryState); ok {
+			latest = *v
+		}
+	})
+	cli.nodeHandlers["ib"] = cli.handleIB
+	queue := make(chan *waBinary.Node, 2)
+	handler := cli.makeFrameHandler(queue)
+	handler(context.Background(), []byte{0, 255})
+	body, _ := waBinary.Marshal(waBinary.Node{Tag: "ib", Content: []waBinary.Node{{Tag: "offline"}}})
+	handler(context.Background(), body)
+	cli.handleDeliveryNode(context.Background(), <-queue)
+	if !latest.Failed || !latest.Boundary || latest.Pending != 0 {
+		t.Fatalf("malformed receive forgotten at boundary: %+v", latest)
+	}
+}
+
+func TestDeliveryWaitsForAsyncAppStateContinuation(t *testing.T) {
+	cli := &Client{Log: waLog.Noop, recvLog: waLog.Noop, nodeHandlers: map[string]nodeHandler{}}
+	var mu sync.Mutex
+	var latest events.DeliveryState
+	settled := make(chan struct{})
+	var settledOnce sync.Once
+	cli.AddEventHandler(func(evt any) {
+		if v, ok := evt.(*events.DeliveryState); ok {
+			mu.Lock()
+			latest = *v
+			mu.Unlock()
+			if v.Boundary && v.Pending == 0 {
+				settledOnce.Do(func() { close(settled) })
+			}
+		}
+	})
+	started, release, finished := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	cli.nodeHandlers["notification"] = func(ctx context.Context, _ *waBinary.Node) {
+		cli.goWithDelivery(ctx, func() { close(started); <-release })
+		close(finished)
+	}
+	cli.nodeHandlers["ib"] = cli.handleIB
+	queue := make(chan *waBinary.Node, 2)
+	handler := cli.makeFrameHandler(queue)
+	body, _ := waBinary.Marshal(waBinary.Node{Tag: "notification"})
+	handler(context.Background(), body)
+	cli.handleDeliveryNode(context.Background(), <-queue)
+	<-started
+	<-finished
+	body, _ = waBinary.Marshal(waBinary.Node{Tag: "ib", Content: []waBinary.Node{{Tag: "offline"}}})
+	handler(context.Background(), body)
+	cli.handleDeliveryNode(context.Background(), <-queue)
+	mu.Lock()
+	pending := latest.Pending
+	mu.Unlock()
+	if pending != 1 {
+		t.Fatalf("async app state overtaken: pending=%d", pending)
+	}
+	close(release)
+	// Receive the exact completion event instead of sleeping or polling.
+	<-settled
+}
