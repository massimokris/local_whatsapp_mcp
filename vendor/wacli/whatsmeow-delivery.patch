@@ -0,0 +1,104 @@
+// Copyright (c) 2026 LocalWhatsAppMCP contributors
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package whatsmeow
+
+// This local integration reports the receive boundary separately from the
+// asynchronous handler queue. It neither changes parsing nor owns persistence.
+import (
+	"context"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types/events"
+	"sync"
+	"sync/atomic"
+)
+
+type deliveryConnectionKey struct{}
+
+func deliveryConnection(ctx context.Context) uint64 {
+	id, _ := ctx.Value(deliveryConnectionKey{}).(uint64)
+	return id
+}
+
+type deliveryTracker struct {
+	mu                    sync.Mutex
+	cli                   *Client
+	id, received, pending uint64
+	boundary, failed      bool
+}
+type deliveryTicket struct {
+	tracker *deliveryTracker
+	node    *waBinary.Node
+	refs    atomic.Int64
+}
+type deliveryTicketKey struct{}
+
+func (d *deliveryTracker) emitLocked() {
+	d.cli.dispatchEvent(&events.DeliveryState{ConnectionID: d.id, Received: d.received, Pending: d.pending, Boundary: d.boundary, Failed: d.failed})
+}
+func (d *deliveryTracker) receive(node *waBinary.Node) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.received++
+	d.pending++
+	if node.Tag == "ib" {
+		for _, child := range node.GetChildren() {
+			if child.Tag == "offline" {
+				d.boundary = true
+			}
+		}
+	}
+	ticket := &deliveryTicket{tracker: d, node: node}
+	ticket.refs.Store(1)
+	d.cli.deliveryTickets.Store(node, ticket)
+	d.emitLocked()
+}
+func (cli *Client) deliveryDone(node *waBinary.Node) {
+	if value, ok := cli.deliveryTickets.Load(node); ok {
+		value.(*deliveryTicket).done()
+	}
+}
+func (ticket *deliveryTicket) done() {
+	if ticket.refs.Add(-1) != 0 {
+		return
+	}
+	d := ticket.tracker
+	d.cli.deliveryTickets.CompareAndDelete(ticket.node, ticket)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.pending--
+	d.emitLocked()
+}
+
+// Acquire the hold before starting a continuation, while its parent ticket is
+// still alive. Socket generations travel with the context through async work.
+func (cli *Client) goWithDelivery(ctx context.Context, fn func()) {
+	ticket, _ := ctx.Value(deliveryTicketKey{}).(*deliveryTicket)
+	if ticket != nil {
+		ticket.refs.Add(1)
+	}
+	go func() {
+		if ticket != nil {
+			defer ticket.done()
+		}
+		fn()
+	}()
+}
+
+func (cli *Client) deliveryContext(ctx context.Context, node *waBinary.Node) context.Context {
+	if value, ok := cli.deliveryTickets.Load(node); ok {
+		ctx = context.WithValue(ctx, deliveryConnectionKey{}, value.(*deliveryTicket).tracker.id)
+		return context.WithValue(ctx, deliveryTicketKey{}, value.(*deliveryTicket))
+	}
+	return ctx
+}
+
+func (cli *Client) handleDeliveryNode(ctx context.Context, node *waBinary.Node) {
+	defer cli.deliveryDone(node)
+	cli.nodeHandlers[node.Tag](cli.deliveryContext(ctx, node), node)
+}
+
+func (d *deliveryTracker) fail() { d.mu.Lock(); defer d.mu.Unlock(); d.failed = true; d.emitLocked() }
