+	}
+}
+func TestSyncCompletionSnapshotRequiresAllUnknownCallCollections(t *testing.T) {
+	a, _, tracker, _ := completionFixture(t)
+	_, work := tracker.begin(t.Context(), "event:call", "", syncDebt{Kind: "AppState", Collections: []string{string(appstate.WAPatchRegularLow), string(appstate.WAPatchRegularHigh)}})
+	work.finish(errors.New("call persistence failure"))
+	if err := a.captureSyncAppStateRecovery(string(appstate.WAPatchRegularLow)).complete(); err != nil {
+		t.Fatal(err)
+	}
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatal("one possible collection forgave an unknown-source call")
+	}
+	if err := a.captureSyncAppStateRecovery(string(appstate.WAPatchRegularHigh)).complete(); err != nil {
+		t.Fatal(err)
+	}
+	tracker.mu.Lock()
+	defer tracker.mu.Unlock()
+	if len(tracker.debts) != 0 {
+		t.Fatal("complete collection coverage retained call debt")
+	}
+}
+func TestSyncCompletionLegacyDebtNeedsExactSuccessfulReplay(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	live := &events.Archive{JID: types.NewJID("15551234567", types.DefaultUserServer), Timestamp: time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC), Action: &waSyncAction.ArchiveChatAction{Archived: proto.Bool(true)}}
+	body, _ := json.Marshal(live)
+	sum := sha256.Sum256(body)
+	key := "event:" + hex.EncodeToString(sum[:])
+	tracker.mu.Lock()
+	tracker.debts[key] = syncDebt{Failed: true}
+	tracker.debts["event:unmatched-legacy-receipt"] = syncDebt{Failed: true}
+	if err := tracker.saveLocked(); err != nil {
+		t.Fatal(err)
+	}
+	tracker.mu.Unlock()
+	replay := *live
+	replay.FromFullSync = true
+	if err := a.persistFetchedAppStateEvents(t.Context(), []any{&replay}, &appStatePersistenceTracker{}); err != nil {
+		t.Fatal(err)
+	}
+	tracker.mu.Lock()
+	defer tracker.mu.Unlock()
+	if _, ok := tracker.debts[key]; ok {
+		t.Fatal("successful exact replay retained legacy debt")
+	}
+	if len(tracker.debts) != 1 {
+		t.Fatal("replay discarded unmatched legacy debt")
+	}
+}
+func TestSyncCompletionRecoveryJournalFailureRemainsError(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	failLiveArchive(t, a, f)
+	recovery := a.captureSyncAppStateRecovery(string(appstate.WAPatchRegularLow))
+	tracker.mu.Lock()
+	oldPath := tracker.path
+	tracker.path = filepath.Join(t.TempDir(), "missing", "journal")
+	tracker.mu.Unlock()
+	if err := recovery.complete(); err == nil {
+		t.Fatal("journal failure accepted")
+	}
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("unsaved recovery=%s", state)
+	}
+	tracker.mu.Lock()
+	tracker.path = oldPath
+	tracker.mu.Unlock()
+}
+
+func TestSyncCompletionStartupRestoresMissingCollectionRecoveryMarker(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	_, work := tracker.begin(t.Context(), "event:interrupted-archive", "", syncDebt{Kind: "Archive", Collections: []string{string(appstate.WAPatchRegularLow)}})
+	work.finish(errors.New("interrupted before marker"))
+	if required, err := a.db.AppStateRecoveryRequired(string(appstate.WAPatchRegularLow)); err != nil || required {
+		t.Fatal("fixture already has database marker", err)
+	}
+	next, err := a.startSyncCompletion(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	completionReady(f)
+	client := &appStateContextWA{fakeWA: f, fetchAppState: func(context.Context, string, bool, bool) error { return nil }}
+	fullLow := false
+	client.fetchEvents = func(_ context.Context, name string, full bool, _ bool) ([]any, error) {
+		if name == string(appstate.WAPatchRegularLow) && full {
+			fullLow = true
+		}
+		return nil, nil
+	}
+	a.wa = client
+	a.syncAppStateDeltas(t.Context(), &sync.Map{})
+	if !fullLow {
+		t.Fatal("journal debt did not request a full snapshot")
+	}
+	if state := completionState(t, next); state != "caught_up" {
+		t.Fatalf("recovered startup=%s", state)
+	}
+}
+
+func TestSyncCompletionPrimarySnapshotRecoversFailedLiveEvent(t *testing.T) {
+	for _, late := range []bool{false, true} {
+		t.Run(map[bool]string{false: "timely", true: "late"}[late], func(t *testing.T) {
+			a, f, tracker, _ := completionFixture(t)
+			completionReady(f)
+			live := failLiveArchive(t, a, f)
+			replay := *live
+			replay.Action = &waSyncAction.ArchiveChatAction{Archived: proto.Bool(false)}
+			replay.FromFullSync = true
+			replay.Timestamp = replay.Timestamp.Add(time.Minute)
+			client := &appStateContextWA{fakeWA: f}
+			client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { return nil, appstate.ErrMismatchingLTHash }
+			emitSnapshot := func() {
+				f.emit(&replay)
+				f.emit(&events.AppStateSyncComplete{Name: appstate.WAPatchRegularLow, Recovery: true})
+			}
+			client.requestAppStateRecovery = func(context.Context, string) (types.MessageID, error) {
+				if !late {
+					emitSnapshot()
+				}
+				return "synthetic-recovery", nil
+			}
+			a.wa = client
+			timeout := time.Second
+			if late {
+				timeout = 20 * time.Millisecond
+			}
+			if err := a.recoverAppStateCollection(t.Context(), string(appstate.WAPatchRegularLow), &sync.Map{}, timeout); err != nil {
+				t.Fatal(err)
+			}
+			if late {
+				if state := completionState(t, tracker); state == "caught_up" {
+					t.Fatal("late snapshot succeeded before arriving")
+				}
+				emitSnapshot()
+			}
+			waitForCondition(t, time.Second, func() bool { return completionState(t, tracker) == "caught_up" })
+		})
+	}
+}
