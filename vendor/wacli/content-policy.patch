+
+// The companion keeps this pipe open. On a supervisor crash, EOF gives the
+// writer the same graceful cancellation as SIGTERM, including pending writes.
+// Scope recovery must still await the store lock; cancellation is not exit.
+func ownedSignalContext(flags *rootFlags, events *out.EventWriter) (context.Context, context.CancelFunc) {
+	if !flags.ownerStdin {
+		return signalContextWithEvents(events)
+	}
+	return signalContextWithOwner(events, os.Stdin)
+}
+
+func signalContextWithOwner(events *out.EventWriter, owner io.Reader) (context.Context, context.CancelFunc) {
+	ctx, stop := signalContextWithEvents(events)
+	go func() {
+		_, _ = io.Copy(io.Discard, owner)
+		if ctx.Err() == nil {
+			_ = events.Emit("owner_lost", map[string]any{"action": "shutdown"})
+			stop()
+		}
+	}()
+	return ctx, stop
+}
