diff --git a/internal/wa/message_recovery.go b/internal/wa/message_recovery.go
new file mode 100644
index 0000000..3706926
--- /dev/null
+++ b/internal/wa/message_recovery.go
@@ -0,0 +1,64 @@
+package wa
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+// A legacy missing-message journal records chat/ID without the original sender.
+// Ask only the user's own primary device about incoming and outgoing variants.
+// The primary may be unable to resolve a group key without its participant;
+// callers must retain the debt until a matching readable message is saved.
+func buildMissingMessageRecoveryRequest(cli *whatsmeow.Client, chat types.JID, id types.MessageID, senders ...types.JID) *waE2E.Message {
+	msg := cli.BuildUnavailableMessageRequest(chat, types.EmptyJID, id)
+	req := msg.GetProtocolMessage().GetPeerDataOperationRequestMessage()
+	outgoing := req.PlaceholderMessageResendRequest[0]
+	incoming := proto.Clone(outgoing).(*waE2E.PeerDataOperationRequestMessage_PlaceholderMessageResendRequest)
+	incoming.MessageKey.FromMe = proto.Bool(false)
+	req.PlaceholderMessageResendRequest = []*waE2E.PeerDataOperationRequestMessage_PlaceholderMessageResendRequest{incoming, outgoing}
+	// Participants only describe possible original senders to our own primary.
+	// They never select the network destination, which stays SendPeerMessage.
+	if chat.Server == types.GroupServer {
+		seen := make(map[string]bool)
+		for _, sender := range senders {
+			if sender.Server != types.DefaultUserServer && sender.Server != types.HiddenUserServer {
+				continue
+			}
+			sender = sender.ToNonAD()
+			if sender.User == "" || seen[sender.String()] {
+				continue
+			}
+			seen[sender.String()] = true
+			item := proto.Clone(incoming).(*waE2E.PeerDataOperationRequestMessage_PlaceholderMessageResendRequest)
+			item.MessageKey.Participant = proto.String(sender.String())
+			req.PlaceholderMessageResendRequest = append(req.PlaceholderMessageResendRequest, item)
+			if len(seen) >= 128 {
+				break
+			}
+		}
+	}
+	return msg
+}
+
+func (c *Client) RequestMissingMessageFromPrimary(ctx context.Context, chat types.JID, id types.MessageID, senders ...types.JID) (types.MessageID, error) {
+	if chat.IsEmpty() || strings.TrimSpace(id) == "" {
+		return "", fmt.Errorf("missing-message recovery requires a chat and message ID")
+	}
+	c.mu.Lock()
+	cli := c.client
+	c.mu.Unlock()
+	if cli == nil || !cli.IsConnected() {
+		return "", fmt.Errorf("not connected")
+	}
+	response, err := cli.SendPeerMessage(ctx, buildMissingMessageRecoveryRequest(cli, chat, id, senders...))
+	if err != nil {
+		return "", err
+	}
+	return response.ID, nil
+}
diff --git a/internal/wa/message_recovery_test.go b/internal/wa/message_recovery_test.go
new file mode 100644
index 0000000..744a4b9
--- /dev/null
+++ b/internal/wa/message_recovery_test.go
@@ -0,0 +1,83 @@
+package wa
+
+import (
+	"fmt"
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	waStore "go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types"
+	waLog "go.mau.fi/whatsmeow/util/log"
+	"testing"
+)
+
+func TestMissingMessageRecoveryRequestsOnlyPrimaryProtocolCopies(t *testing.T) {
+	cli := whatsmeow.NewClient(&waStore.Device{}, waLog.Noop)
+	chat := types.NewJID("120363000000001", types.GroupServer)
+	msg := buildMissingMessageRecoveryRequest(cli, chat, "synthetic-missing")
+	if msg.GetConversation() != "" || msg.GetExtendedTextMessage() != nil {
+		t.Fatal("recovery created human content")
+	}
+	protocol := msg.GetProtocolMessage()
+	if protocol.GetType() != waE2E.ProtocolMessage_PEER_DATA_OPERATION_REQUEST_MESSAGE {
+		t.Fatal("unexpected protocol type")
+	}
+	request := protocol.GetPeerDataOperationRequestMessage()
+	if request.GetPeerDataOperationRequestType() != waE2E.PeerDataOperationRequestType_PLACEHOLDER_MESSAGE_RESEND {
+		t.Fatal("unexpected primary request type")
+	}
+	keys := request.GetPlaceholderMessageResendRequest()
+	if len(keys) != 2 {
+		t.Fatalf("keys=%d", len(keys))
+	}
+	for i, item := range keys {
+		key := item.GetMessageKey()
+		if key.GetRemoteJID() != chat.String() || key.GetID() != "synthetic-missing" || key.GetFromMe() != (i == 1) || key.GetParticipant() != "" {
+			t.Fatalf("unexpected message key %+v", key)
+		}
+	}
+}
+
+func TestMissingMessageRecoveryBoundsAndDeduplicatesGroupParticipantKeys(t *testing.T) {
+	cli := whatsmeow.NewClient(&waStore.Device{}, waLog.Noop)
+	chat := types.NewJID("120363000000001", types.GroupServer)
+	first := types.NewJID("15550000000", types.DefaultUserServer)
+	firstDevice := first
+	firstDevice.Device = 5
+	candidates := []types.JID{first, firstDevice, types.EmptyJID, types.NewJID("not-a-sender", types.GroupServer)}
+	for i := 0; i < 200; i++ {
+		candidates = append(candidates, types.NewJID(fmt.Sprint(15550000000+i), types.DefaultUserServer))
+	}
+	msg := buildMissingMessageRecoveryRequest(cli, chat, "synthetic-missing", candidates...)
+	keys := msg.GetProtocolMessage().GetPeerDataOperationRequestMessage().GetPlaceholderMessageResendRequest()
+	if len(keys) != 130 {
+		t.Fatalf("keys=%d want130 bounded metadata candidates", len(keys))
+	}
+	seen := map[string]bool{}
+	for i, item := range keys {
+		key := item.GetMessageKey()
+		if key.GetRemoteJID() != chat.String() || key.GetID() != "synthetic-missing" {
+			t.Fatal("participant changed target message")
+		}
+		if i < 2 {
+			continue
+		}
+		participant := key.GetParticipant()
+		parsed, err := types.ParseJID(participant)
+		if err != nil || parsed.Server != types.DefaultUserServer || parsed.Device != 0 || seen[participant] || key.GetFromMe() {
+			t.Fatalf("invalid duplicate/group participant metadata %+v", key)
+		}
+		seen[participant] = true
+	}
+	if msg.GetConversation() != "" || msg.GetExtendedTextMessage() != nil {
+		t.Fatal("participant lookup created human content")
+	}
+}
+
+func TestMissingMessageRecoveryIgnoresParticipantCandidatesForDirectChats(t *testing.T) {
+	cli := whatsmeow.NewClient(&waStore.Device{}, waLog.Noop)
+	chat := types.NewJID("15550000001", types.DefaultUserServer)
+	msg := buildMissingMessageRecoveryRequest(cli, chat, "synthetic-missing", types.NewJID("15550000002", types.DefaultUserServer))
+	if got := len(msg.GetProtocolMessage().GetPeerDataOperationRequestMessage().GetPlaceholderMessageResendRequest()); got != 2 {
+		t.Fatalf("direct request included participants: %d", got)
+	}
+}
