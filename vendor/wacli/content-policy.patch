index 0000000..405b039
--- /dev/null
+++ b/internal/app/sync_unavailable_completion_test.go
@@ -0,0 +1,119 @@
+package app
+
+import (
+	"strings"
+	"testing"
+
+	"go.mau.fi/whatsmeow"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	waStore "go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+// The actual pinned SDK parses <unavailable type=view_once>, then the normal
+// application handler classifies the event. No WhatsApp session or socket exists.
+func emitSDKViewOnceUnavailable(t *testing.T, f *fakeWA, chat types.JID, id string) {
+	t.Helper()
+	cli := whatsmeow.NewClient(&waStore.Device{}, waLog.Noop)
+	cli.SynchronousAck = true
+	cli.AutomaticMessageRerequestFromPhone = false
+	count := 0
+	cli.AddEventHandler(func(evt any) {
+		if v, ok := evt.(*events.UndecryptableMessage); ok {
+			count++
+			f.emit(v)
+		}
+	})
+	info := &types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: chat}, ID: id}
+	node := &waBinary.Node{Tag: "message", Attrs: waBinary.Attrs{"from": chat, "id": id}, Content: []waBinary.Node{{Tag: "unavailable", Attrs: waBinary.Attrs{"type": "view_once"}}}}
+	cli.DangerousInternals().DecryptMessages(t.Context(), info, node)
+	if count != 1 {
+		t.Fatalf("SDK event count=%d", count)
+	}
+}
+func TestSyncCompletionSDKViewOnceUnavailableIsExpected(t *testing.T) {
+	_, f, tracker, output := completionFixture(t)
+	completionReady(f)
+	emitSDKViewOnceUnavailable(t, f, types.NewJID("15551234567", types.DefaultUserServer), "synthetic-view-once")
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("intentional unavailable sync=%s", state)
+	}
+	if len(tracker.debts) != 0 {
+		t.Fatal("intentional unavailability created durable work")
+	}
+	if !strings.Contains(output.String(), `"recovery":"expected_unavailable"`) || !strings.Contains(output.String(), "intentionally unavailable (view_once)") {
+		t.Fatal("expected-unavailable warning missing")
+	}
+}
+func TestSyncCompletionSDKViewOnceResolvesOnlyItsExactLegacyFailure(t *testing.T) {
+	_, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	chat := types.NewJID("15551234567", types.DefaultUserServer)
+	key := "message:" + chat.String() + ":synthetic-view-once"
+	tracker.mu.Lock()
+	tracker.debts[key] = syncDebt{Chat: chat.String(), Failed: true}
+	tracker.debts[key+":mutation:unsaved-edit"] = syncDebt{Chat: chat.String(), Failed: true}
+	tracker.debts["message:"+chat.String()+":other-missing"] = syncDebt{Chat: chat.String(), Failed: true}
+	if err := tracker.saveLocked(); err != nil {
+		t.Fatal(err)
+	}
+	tracker.mu.Unlock()
+	emitSDKViewOnceUnavailable(t, f, chat, "synthetic-view-once")
+	tracker.mu.Lock()
+	defer tracker.mu.Unlock()
+	if _, exists := tracker.debts[key]; exists {
+		t.Fatal("matching verified view_once event retained old false failure")
+	}
+	if len(tracker.debts) != 2 {
+		t.Fatal("expected-unavailable event cleared unrelated or mutation debt")
+	}
+	if state := tracker.stateLocked(); state != "error" {
+		t.Fatalf("remaining real failures=%s", state)
+	}
+}
+func TestSyncCompletionUnclassifiedAndHiddenFailuresRemainErrors(t *testing.T) {
+	cases := []struct {
+		name        string
+		unavailable bool
+		kind        events.UnavailableType
+		mode        events.DecryptFailMode
+	}{
+		{"unknown-no-ciphertext", true, events.UnavailableTypeUnknown, events.DecryptFailShow},
+		{"hidden-decrypt-failure", false, events.UnavailableTypeUnknown, events.DecryptFailHide},
+		{"inconsistent-view-once", false, events.UnavailableTypeViewOnce, events.DecryptFailShow},
+		{"unknown-future-type", true, events.UnavailableType("future-type"), events.DecryptFailShow},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, f, tracker, _ := completionFixture(t)
+			completionReady(f)
+			chat := types.NewJID("15551234567", types.DefaultUserServer)
+			f.emit(&events.UndecryptableMessage{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: chat}, ID: "synthetic-missing"}, IsUnavailable: tc.unavailable, UnavailableType: tc.kind, DecryptFailMode: tc.mode})
+			if state := completionState(t, tracker); state != "error" || len(tracker.debts) != 1 {
+				t.Fatalf("unrecovered message accepted: sync=%s debts=%d", state, len(tracker.debts))
+			}
+		})
+	}
+}
+func TestSyncCompletionSDKViewOnceHonorsSelectedChatScope(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	allowed := types.NewJID("15551234567", types.DefaultUserServer)
+	excluded := types.NewJID("15550000000", types.DefaultUserServer)
+	a.contentPolicy = &contentPolicy{Version: 1, Revision: 7, Mode: "selected", ChatIDs: []string{allowed.String()}, allowed: map[string]struct{}{allowed.String(): {}}}
+	tracker.mu.Lock()
+	key := "message:" + excluded.String() + ":synthetic-view-once"
+	tracker.debts[key] = syncDebt{Chat: excluded.String(), Failed: true}
+	if err := tracker.saveLocked(); err != nil {
+		t.Fatal(err)
+	}
+	tracker.mu.Unlock()
+	emitSDKViewOnceUnavailable(t, f, excluded, "synthetic-view-once")
+	tracker.mu.Lock()
+	defer tracker.mu.Unlock()
+	if _, exists := tracker.debts[key]; !exists {
+		t.Fatal("excluded chat event settled retained work")
+	}
+}
