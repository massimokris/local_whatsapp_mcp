+type retryDeletionAfterLogout struct {
+	store.DeviceContainer
+	observed <-chan struct{}
+}
+
+func (c retryDeletionAfterLogout) DeleteDevice(ctx context.Context, device *store.Device) error {
+	<-c.observed
+	return c.DeviceContainer.DeleteDevice(ctx, device)
+}
+
+func TestExplicitAuthAfterRevocationCanProduceFreshQR(t *testing.T) {
+	dir := t.TempDir()
+	ctx := context.Background()
+	container, device := seedRetryDevice(t, dir)
+	sdk := whatsmeow.NewClient(device, nil)
+	logoutCtx, cancelLogout := context.WithCancel(ctx)
+	observed := make(chan struct{})
+	sdk.AddEventHandler(func(evt any) {
+		if _, ok := evt.(*events.LoggedOut); ok {
+			if err := MarkSessionRevoked(dir, "logged_out"); err != nil {
+				t.Error(err)
+			}
+			cancelLogout()
+			close(observed)
+		}
+	})
+	// Pin the real SDK's asynchronous logout dispatch before the session delete.
+	device.Container = retryDeletionAfterLogout{device.Container, observed}
+	sdk.DangerousInternals().HandleConnectFailure(logoutCtx, &waBinary.Node{Tag: "failure", Attrs: waBinary.Attrs{"reason": "401"}})
+	<-observed
+	container.Close()
+
+	a, err := New(Options{StoreDir: dir, AllowUnauthed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	// Intercept every dial, while retaining the actual auth/SDK selection path.
+	retryCtx, cancelRetry := context.WithCancel(ctx)
+	defer cancelRetry()
+	transport := http.DefaultTransport
+	http.DefaultTransport = &http.Transport{DialContext: func(context.Context, string, string) (net.Conn, error) {
+		cancelRetry()
+		return nil, errors.New("synthetic dial withheld")
+	}}
+	defer func() { http.DefaultTransport = transport }()
+	_, _ = a.Sync(retryCtx, SyncOptions{AllowQR: true, Mode: SyncModeFollow})
+	if a.WA() == nil {
+		t.Fatal("explicit auth did not initialize session")
+	}
+	if a.WA().IsAuthed() {
+		t.Fatal("explicit retry retained the revoked device ID: real Connect bypasses QR and logs out again")
+	}
+
+	// Validate the pinned SDK can actually emit the next QR from this saved
+	// session, not a shell fixture that claims auth succeeded.
+	retryStore, err := sqlstore.New(ctx, "sqlite3", "file:"+filepath.Join(dir, "session.db")+"?_foreign_keys=on", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer retryStore.Close()
+	freshDevice, err := retryStore.GetFirstDevice(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	freshSDK := whatsmeow.NewClient(freshDevice, nil)
+	qrCtx, cancelQR := context.WithCancel(ctx)
+	defer cancelQR()
+	qr, err := freshSDK.GetQRChannel(qrCtx)
+	if err != nil {
+		t.Fatalf("explicit retry cannot produce fresh QR: %v", err)
+	}
+	freshSDK.DangerousInternals().DispatchEvent(&events.QR{Codes: []string{"synthetic-fresh-qr"}})
+	select {
+	case item := <-qr:
+		if item.Event != whatsmeow.QRChannelEventCode || item.Code == "" {
+			t.Fatal("explicit retry produced no QR")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("explicit retry stalled before fresh QR")
+	}
+	if _, err := os.Stat(filepath.Join(dir, sessionRevokedFilename)); !os.IsNotExist(err) {
+		t.Fatal("old revocation remained after explicit session cleanup")
+	}
+}
+
+func seedRetryDevice(t *testing.T, dir string) (*sqlstore.Container, *store.Device) {
+	t.Helper()
+	ctx := context.Background()
+	container, err := sqlstore.New(ctx, "sqlite3", "file:"+filepath.Join(dir, "session.db")+"?_foreign_keys=on", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	device := container.NewDevice()
+	jid := types.NewADJID("10000000000", 0, 1)
+	device.ID = &jid
+	device.Account = &waAdv.ADVSignedDeviceIdentity{Details: []byte{}, AccountSignature: make([]byte, 64), AccountSignatureKey: make([]byte, 32), DeviceSignature: make([]byte, 64)}
+	if err := device.Save(ctx); err != nil {
+		t.Fatal(err)
+	}
+
+	return container, device
+}
+
+func TestRevokedSessionRelinkCleanupBoundary(t *testing.T) {
+	for _, tc := range []struct {
+		name                                                                     string
+		explicit, marker, row, denyDelete, canceled, brokenMarker, removeFailure bool
+		wantError, wantRow, wantMarker                                           bool
+	}{
+		{name: "explicit revoked", explicit: true, marker: true, row: true},
+		{name: "cleanup already finished", explicit: true, marker: true},
+		{name: "healthy credentials", explicit: true, row: true, wantRow: true},
+		{name: "ordinary session open", marker: true, row: true, wantRow: true, wantMarker: true},
+		{name: "delete failure", explicit: true, marker: true, row: true, denyDelete: true, wantError: true, wantRow: true, wantMarker: true},
+		{name: "marker removal failure", explicit: true, marker: true, row: true, removeFailure: true, wantError: true, wantMarker: true},
+		{name: "canceled retry", explicit: true, marker: true, row: true, canceled: true, wantError: true, wantRow: true, wantMarker: true},
+		{name: "marker read failure", explicit: true, row: true, brokenMarker: true, wantError: true, wantRow: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			if tc.row {
+				container, _ := seedRetryDevice(t, dir)
+				container.Close()
+			}
+			a, err := New(Options{StoreDir: dir, AllowUnauthed: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer a.Close()
+			if err := a.db.UpsertChat("10000000000@s.whatsapp.net", "dm", "Fixture", time.Unix(1, 0)); err != nil {
+				t.Fatal(err)
+			}
+			if err := a.db.UpsertMessage(archive.UpsertMessageParams{ChatJID: "10000000000@s.whatsapp.net", MsgID: "retained", Timestamp: time.Unix(1, 0), Text: "synthetic retained archive"}); err != nil {
+				t.Fatal(err)
+			}
+			journal := []byte(`{"event:synthetic":{"kind":"Event","sequence":1},"history:synthetic":{"kind":"History","sequence":2}}`)
+			journalPath := filepath.Join(dir, "sync-debts.json")
+			if err := os.WriteFile(journalPath, journal, 0600); err != nil {
+				t.Fatal(err)
+			}
+			markerPath := filepath.Join(dir, sessionRevokedFilename)
+			if tc.marker {
+				if err := MarkSessionRevoked(dir, "logged_out"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if tc.removeFailure {
+				if err := os.Remove(markerPath); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Mkdir(markerPath, 0700); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(markerPath, "blocked"), nil, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if tc.brokenMarker {
+				if err := os.Symlink(sessionRevokedFilename, markerPath); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if tc.denyDelete {
+				db, err := sql.Open("sqlite3", filepath.Join(dir, "session.db"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				_, err = db.Exec(`CREATE TRIGGER refuse_delete BEFORE DELETE ON whatsmeow_device BEGIN SELECT RAISE(ABORT,'synthetic deletion failure'); END`)
+				db.Close()
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if tc.canceled {
+				cancel()
+			}
+			err = a.openWA(ctx, tc.explicit)
+			if (err != nil) != tc.wantError {
+				t.Fatalf("session preparation error=%v", err)
+			}
+			if tc.wantError && a.WA() != nil {
+				t.Fatal("failed cleanup initialized a client")
+			}
+			container, err := sqlstore.New(context.Background(), "sqlite3", "file:"+filepath.Join(dir, "session.db")+"?_foreign_keys=on", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer container.Close()
+			device, err := container.GetFirstDevice(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if (device.ID != nil) != tc.wantRow {
+				t.Fatal("session row changed outside explicit revoked cleanup")
+			}
+			if !tc.brokenMarker {
+				marker, err := SessionRevoked(dir)
+				if err != nil || marker != tc.wantMarker {
+					t.Fatalf("marker=%v error=%v", marker, err)
+				}
+			}
+			message, err := a.db.GetMessage("10000000000@s.whatsapp.net", "retained")
+			if err != nil || message.Text != "synthetic retained archive" {
+				t.Fatal("relink changed archive", err)
+			}
+			got, err := os.ReadFile(journalPath)
+			if err != nil || !bytes.Equal(got, journal) {
+				t.Fatal("relink changed pending recovery journal", err)
+			}
+			if tc.removeFailure {
+				if err := os.Remove(filepath.Join(markerPath, "blocked")); err != nil {
+					t.Fatal(err)
+				}
+				if err := a.openWA(ctx, true); err != nil {
+					t.Fatal("retry after marker removal failure", err)
+				}
+				if a.WA().IsAuthed() {
+					t.Fatal("cleanup retry restored revoked credentials")
+				}
+			}
+		})
+	}
+}
+
+func TestRelinkInterruptionAfterNewDeviceSavePreservesFreshSession(t *testing.T) {
+	dir := t.TempDir()
+	old, _ := seedRetryDevice(t, dir)
+	old.Close()
+	if err := MarkSessionRevoked(dir, "logged_out"); err != nil {
+		t.Fatal(err)
+	}
+	first, err := New(Options{StoreDir: dir, AllowUnauthed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := first.openWA(context.Background(), true); err != nil {
+		t.Fatal(err)
+	}
+	first.Close()
+	// PairSuccess saves the new credentials before Connected. Simulate owner
+	// loss at exactly that boundary, leaving the fresh SDK device on disk.
+	paired, fresh := seedRetryDevice(t, dir)
+	expected := fresh.NoiseKey.Pub
+	paired.Close()
+	retry, err := New(Options{StoreDir: dir, AllowUnauthed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer retry.Close()
+	if err := retry.openWA(context.Background(), true); err != nil {
+		t.Fatal(err)
+	}
+	if !retry.WA().IsAuthed() {
+		t.Fatal("retry deleted newly paired credentials before confirmed login")
+	}
+	saved, err := sqlstore.New(context.Background(), "sqlite3", "file:"+filepath.Join(dir, "session.db")+"?_foreign_keys=on", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer saved.Close()
+	device, err := saved.GetFirstDevice(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(device.NoiseKey.Pub[:], expected[:]) {
+		t.Fatal("retry replaced freshly paired device")
+	}
+}
