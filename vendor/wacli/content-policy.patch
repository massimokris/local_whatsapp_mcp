new file mode 100644
index 0000000..d5dfe61
--- /dev/null
+++ b/internal/app/sync_repair.go
@@ -0,0 +1,95 @@
+package app
+
+import (
+	"context"
+	"sort"
+	"strings"
+
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// repairPendingSync is explicitly requested by the private engine operator.
+// Legacy event hashes do not identify a collection, so replay all known
+// collections but only settle debts that the normal recovery can verify.
+// A missing-message request never proves recovery: the ordinary event handler
+// must receive and save the matching message before its debt can be removed.
+func (a *App) repairPendingSync(ctx context.Context) error {
+	a.syncCompletionMu.Lock()
+	tracker := a.syncCompletion
+	a.syncCompletionMu.Unlock()
+	if tracker == nil {
+		return nil
+	}
+	tracker.mu.Lock()
+	legacyEvents := false
+	pending := make(map[string]syncDebt)
+	for key, debt := range tracker.debts {
+		if tracker.activeKeys[key] != 0 {
+			continue
+		}
+		if strings.HasPrefix(key, "event:") && debt.Kind == "" {
+			legacyEvents = true
+		}
+		if strings.HasPrefix(key, "message:") && !strings.Contains(key, ":mutation:") {
+			pending[key] = debt
+		}
+	}
+	tracker.mu.Unlock()
+	if legacyEvents {
+		for _, name := range appstate.AllPatchNames {
+			if err := a.db.MarkAppStateRecoveryRequired(string(name)); err != nil {
+				return err
+			}
+		}
+	}
+	keys := make([]string, 0, len(pending))
+	for key := range pending {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	// Keep the opt-in repair bounded; another explicit run may retry the rest.
+	if len(keys) > 16 {
+		keys = keys[:16]
+	}
+	for _, key := range keys {
+		parts := strings.SplitN(strings.TrimPrefix(key, "message:"), ":", 2)
+		if len(parts) != 2 || parts[1] == "" {
+			continue
+		}
+		chat, err := types.ParseJID(parts[0])
+		if err != nil || chat.IsEmpty() {
+			continue
+		}
+		if a.CheckContentScope(ctx, chat.String()) != nil {
+			continue
+		}
+		var senders []types.JID
+		if chat.Server == types.GroupServer {
+			participants, lookupErr := a.db.ListGroupParticipants(chat.String())
+			if lookupErr != nil {
+				a.emitWarning("sync_message_recovery_participants_unavailable", "Known group participants could not be read; the missing-message failure is retained.", nil)
+			} else {
+				var phoneFallbacks []types.JID
+				for _, participant := range participants {
+					if sender, parseErr := types.ParseJID(participant.UserJID); parseErr == nil {
+						preferred := sender
+						if sender.Server == types.DefaultUserServer {
+							if lid := a.wa.ResolvePNToLID(ctx, sender); lid.Server == types.HiddenUserServer && !lid.IsEmpty() {
+								preferred = lid
+								phoneFallbacks = append(phoneFallbacks, sender)
+							}
+						}
+						senders = append(senders, preferred)
+					}
+				}
+				// Prefer verified LIDs for every member before bounded PN fallbacks.
+				senders = append(senders, phoneFallbacks...)
+			}
+		}
+		if _, err = a.wa.RequestMissingMessageFromPrimary(ctx, chat, parts[1], senders...); err != nil {
+			a.emitWarning("sync_message_recovery_request_failed", "Could not request a missing message from the primary device; its sync failure is retained.", nil)
+		}
+	}
+	return nil
+}
