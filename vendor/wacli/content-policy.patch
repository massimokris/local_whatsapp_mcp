@@ -0,0 +1,58 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/openclaw/wacli/internal/out"
+	"github.com/spf13/cobra"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// This metadata-only command gives the companion the same verified identities
+// as the archive without requiring it to read or write WhatsApp session state.
+func newContentPolicyCmd(flags *rootFlags) *cobra.Command {
+	root := &cobra.Command{Use: "policy", Short: "Companion content policy integration"}
+	var chats []string
+	resolve := &cobra.Command{Use: "resolve", Short: "Resolve a stable chat identity and verified local aliases", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, args []string) error {
+		jids := make([]types.JID, 0, len(chats))
+		for _, chat := range chats {
+			jid, err := types.ParseJID(chat)
+			if err != nil || jid.IsEmpty() || !strings.Contains(chat, "@") || (jid.Server != types.DefaultUserServer && jid.Server != types.HiddenUserServer && jid.Server != types.GroupServer) {
+				return fmt.Errorf("a stable chat JID is required")
+			}
+			jids = append(jids, jid.ToNonAD())
+		}
+		ro := *flags
+		ro.readOnly = true
+		ctx, cancel := withTimeout(cmd.Context(), &ro)
+		defer cancel()
+		a, lk, err := newApp(ctx, &ro, false, false)
+		if err != nil {
+			return err
+		}
+		defer closeApp(a, lk)
+		ids := make([]string, 0, len(jids))
+		groups := make(map[string][]string, len(jids))
+		seen := make(map[string]bool, len(jids))
+		for _, jid := range jids {
+			aliases, err := messageChatJIDFilter(ctx, a, jid.String())
+			if err != nil {
+				return err
+			}
+			groups[jid.String()] = aliases
+			for _, alias := range aliases {
+				if !seen[alias] {
+					ids = append(ids, alias)
+					seen[alias] = true
+				}
+			}
+		}
+		return out.WriteJSON(os.Stdout, map[string]any{"chat_ids": ids, "groups": groups})
+	}}
+	resolve.Flags().StringArrayVar(&chats, "chat", nil, "stable chat JID (repeat for a verified identity union)")
+	_ = resolve.MarkFlagRequired("chat")
+	root.AddCommand(resolve)
+	return root
+}
