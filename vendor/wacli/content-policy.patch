+
+func readDecryptionEvidence(t *testing.T, tracker *syncCompletion) (map[string]any, []byte) {
+	t.Helper()
+	body, err := os.ReadFile(tracker.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var journal map[string]map[string]any
+	if err = json.Unmarshal(body, &journal); err != nil {
+		t.Fatal(err)
+	}
+	if len(journal) != 1 {
+		t.Fatalf("journal entries=%d, want one", len(journal))
+	}
+	for _, debt := range journal {
+		evidence, ok := debt["undecryptable"].(map[string]any)
+		if !ok {
+			t.Fatal("undecryptable classification missing from durable journal")
+		}
+		return evidence, body
+	}
+	return nil, nil
+}
+
+func TestSyncUndecryptableEvidenceWrittenBeforeHandlerAndSurvivesRestart(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	chat := types.NewJID("15551234567", types.DefaultUserServer)
+	sender := types.NewJID("15557654321", types.DefaultUserServer)
+	alternate := types.NewJID("987654321", types.HiddenUserServer)
+	timestamp := time.Date(2026, 10, 1, 18, 24, 15, 123000000, time.FixedZone("synthetic", -7*3600))
+	evt := &events.UndecryptableMessage{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: sender, SenderAlt: alternate, IsFromMe: true, IsGroup: false}, ID: "synthetic-undecipherable", Timestamp: timestamp, Type: "text", Category: "peer", PushName: "PRIVATE NAME MUST NEVER PERSIST", DeviceSentMeta: &types.DeviceSentMeta{Phash: "PRIVATE KEY MUST NEVER PERSIST"}}, IsUnavailable: false, UnavailableType: events.UnavailableTypeUnknown, DecryptFailMode: events.DecryptFailHide}
+	ctx, work := a.beginSyncEvent(t.Context(), evt)
+	evidence, body := readDecryptionEvidence(t, tracker)
+	want := map[string]any{"is_unavailable": false, "unavailable_type": "", "decrypt_fail_mode": "hide", "timestamp": timestamp.UTC().Format(time.RFC3339Nano), "message_type": "text", "category": "peer", "sender": sender.String(), "sender_alt": alternate.String(), "from_me": true, "is_group": false}
+	for field, value := range want {
+		if evidence[field] != value {
+			t.Fatalf("field %s=%v, want %v", field, evidence[field], value)
+		}
+	}
+	if len(evidence) != len(want) {
+		t.Fatalf("unexpected diagnostic fields: %v", evidence)
+	}
+	if strings.Contains(string(body), "PRIVATE") {
+		t.Fatal("content or keys leaked to journal")
+	}
+	// Fail through the same record/finish operations used by the event handler.
+	recordSyncFailure(ctx, assertDecryptionError{})
+	work.finish(nil)
+	next, err := a.startSyncCompletion(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	restarted, _ := readDecryptionEvidence(t, next)
+	for field, value := range want {
+		if restarted[field] != value {
+			t.Fatalf("restart lost %s", field)
+		}
+	}
+	if state := completionState(t, next); state != "error" {
+		t.Fatalf("diagnostic metadata cleared failure=%s", state)
+	}
+}
+
+type assertDecryptionError struct{}
+
+func (assertDecryptionError) Error() string { return "synthetic decryption failure" }
+
+func TestSyncUndecryptableEvidenceAllowlistsClassification(t *testing.T) {
+	_, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	chat := types.NewJID("15551234567", types.DefaultUserServer)
+	evt := &events.UndecryptableMessage{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: types.NewJID("PRIVATE BODY", types.DefaultUserServer), SenderAlt: types.NewJID("123456", "untrusted.example")}, ID: "synthetic-unknown", Type: "PRIVATE TYPE", Category: "PRIVATE CATEGORY"}, UnavailableType: events.UnavailableType("PRIVATE UNAVAILABLE"), DecryptFailMode: events.DecryptFailMode("PRIVATE FAIL")}
+	f.emit(evt)
+	evidence, body := readDecryptionEvidence(t, tracker)
+	for _, field := range []string{"unavailable_type", "decrypt_fail_mode", "message_type", "category"} {
+		if evidence[field] != "other" {
+			t.Fatalf("unclassified %s=%v", field, evidence[field])
+		}
+	}
+	for _, field := range []string{"sender", "sender_alt"} {
+		if _, ok := evidence[field]; ok {
+			t.Fatalf("untrusted identity retained in %s", field)
+		}
+	}
+	if strings.Contains(string(body), "PRIVATE") {
+		t.Fatal("raw unknown classification or invalid sender persisted")
+	}
+}
+
+func TestSyncUndecryptableExcludedChatDoesNotPersistEvidence(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	a.contentPolicy.Mode = "selected"
+	a.contentPolicy.ChatIDs = []string{"15551234567@s.whatsapp.net"}
+	a.contentPolicy.allowed = map[string]struct{}{"15551234567@s.whatsapp.net": {}}
+	completionReady(f)
+	excluded := types.NewJID("15550000000", types.DefaultUserServer)
+	f.emit(&events.UndecryptableMessage{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: excluded, Sender: excluded}, ID: "excluded-must-not-persist"}, IsUnavailable: true, DecryptFailMode: events.DecryptFailHide})
+	body, err := os.ReadFile(tracker.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var journal map[string]any
+	if err = json.Unmarshal(body, &journal); err != nil {
+		t.Fatal(err)
+	}
+	if len(journal) != 0 {
+		t.Fatal("scope-excluded decryption metadata persisted")
+	}
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("scope-excluded event affected completion=%s", state)
+	}
+}
