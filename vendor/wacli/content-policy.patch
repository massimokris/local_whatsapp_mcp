@@ -0,0 +1,109 @@
+package app
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/store"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func failedReceiptFixture(t *testing.T) (*App, *fakeWA, *syncCompletion, *sql.DB, *events.Receipt) {
+	t.Helper()
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	chat := types.NewJID("15551234567", types.DefaultUserServer)
+	seedReceiptChat(t, a, chat, "dm", []store.UpsertMessageParams{{MsgID: "receipt-retry", FromMe: true}}, 0)
+	raw, err := sql.Open("sqlite3", filepath.Join(a.opts.StoreDir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { raw.Close() })
+	if _, err = raw.Exec(`CREATE TRIGGER fail_sync_receipt BEFORE INSERT ON message_receipts BEGIN SELECT RAISE(FAIL, 'synthetic receipt write failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	receipt := &events.Receipt{MessageSource: types.MessageSource{Chat: chat}, MessageIDs: []types.MessageID{"receipt-retry"}, Type: types.ReceiptTypeRead, Timestamp: time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)}
+	f.emit(receipt)
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("failed receipt=%s", state)
+	}
+	return a, f, tracker, raw, receipt
+}
+func TestSyncCompletionReceiptFailureRetriesAfterRestart(t *testing.T) {
+	a, f, tracker, raw, receipt := failedReceiptFixture(t)
+	tracker.mu.Lock()
+	for _, debt := range tracker.debts {
+		if debt.Receipt == nil || debt.Chat != receipt.Chat.String() {
+			t.Fatal("receipt recovery metadata was not saved")
+		}
+	}
+	tracker.mu.Unlock()
+	next, err := a.startSyncCompletion(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	completionReady(f)
+	a.retrySyncReceiptDebts(t.Context())
+	if state := completionState(t, next); state != "error" {
+		t.Fatal("retry forgave a continuing database failure")
+	}
+	if _, err = raw.Exec(`DROP TRIGGER fail_sync_receipt`); err != nil {
+		t.Fatal(err)
+	}
+	a.retrySyncReceiptDebts(t.Context())
+	if state := completionState(t, next); state != "caught_up" {
+		t.Fatalf("saved receipt=%s", state)
+	}
+	counts, err := a.db.MessageReceipts(receipt.Chat.String(), "receipt-retry")
+	if err != nil || counts.Read != 1 {
+		t.Fatalf("receipt not recovered: %+v error=%v", counts, err)
+	}
+	if len(readReceiptCallsOf(f)) != 0 {
+		t.Fatal("local recovery sent read receipts")
+	}
+}
+func TestSyncCompletionReceiptFailureRetriesDuringSyncStartup(t *testing.T) {
+	a, _, _, raw, receipt := failedReceiptFixture(t)
+	if _, err := raw.Exec(`DROP TRIGGER fail_sync_receipt`); err != nil {
+		t.Fatal(err)
+	}
+	done := errors.New("startup checked")
+	_, err := a.Sync(context.Background(), SyncOptions{Mode: SyncModeOnce, AfterConnect: func(context.Context) error {
+		counts, readErr := a.db.MessageReceipts(receipt.Chat.String(), "receipt-retry")
+		if readErr != nil || counts.Read != 1 {
+			t.Fatalf("startup did not persist saved receipt: %+v error=%v", counts, readErr)
+		}
+		return done
+	}})
+	if !errors.Is(err, done) {
+		t.Fatalf("startup result=%v", err)
+	}
+}
+func TestSyncCompletionReceiptRecoveryHonorsChangedChatScope(t *testing.T) {
+	a, f, _, raw, receipt := failedReceiptFixture(t)
+	if _, err := raw.Exec(`DROP TRIGGER fail_sync_receipt`); err != nil {
+		t.Fatal(err)
+	}
+	a.contentPolicy.Mode = "selected"
+	a.contentPolicy.ChatIDs = []string{"15550000000@s.whatsapp.net"}
+	a.contentPolicy.allowed = map[string]struct{}{"15550000000@s.whatsapp.net": {}}
+	next, err := a.startSyncCompletion(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	completionReady(f)
+	a.retrySyncReceiptDebts(t.Context())
+	f.emit(receipt)
+	counts, err := a.db.MessageReceipts(receipt.Chat.String(), "receipt-retry")
+	if err != nil || counts.Delivered != 0 {
+		t.Fatalf("excluded receipt persisted: %+v error=%v", counts, err)
+	}
+	if state := completionState(t, next); state != "caught_up" {
+		t.Fatalf("excluded receipt retained debt=%s", state)
+	}
+}
