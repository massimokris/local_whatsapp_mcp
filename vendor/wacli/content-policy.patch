+func TestContentPolicyRejectsCachedMediaBeforeCopy(t *testing.T) {
+	dir := t.TempDir()
+	db, err := store.Open(filepath.Join(dir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	chat := "111@s.whatsapp.net"
+	data := []byte("synthetic private media")
+	hash := sha256.Sum256(data)
+	cached := filepath.Join(dir, "cached")
+	if err := os.WriteFile(cached, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.UpsertChat(chat, "dm", "Synthetic", time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.UpsertMessage(store.UpsertMessageParams{ChatJID: chat, MsgID: "old", Timestamp: time.Now(), MediaType: "audio", DirectPath: "expired", MediaKey: make([]byte, 32), FileSHA256: hash[:], FileLength: uint64(len(data))}); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.MarkMediaDownloaded(chat, "old", cached, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+	policy := filepath.Join(dir, "policy.json")
+	if err := os.WriteFile(policy, []byte(`{"version":1,"revision":2,"mode":"selected","chat_ids":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"read-only", "writable"} {
+		t.Run(mode, func(t *testing.T) {
+			target := filepath.Join(dir, "output-"+mode)
+			args := []string{"--store", dir, "--content-policy", policy, "--json", "media", "download", "--chat", chat, "--id", "old", "--output", target}
+			if mode == "read-only" {
+				args = append([]string{"--read-only"}, args...)
+			}
+			stdout, stderr, err := runPresenceDelegateHelper(t, args)
+			if err == nil || !strings.Contains(stderr, "content excluded") {
+				t.Fatalf("excluded cache result error=%v out=%s err=%s", err, stdout, stderr)
+			}
+			if _, err := os.Stat(target); !os.IsNotExist(err) {
+				t.Fatalf("excluded bytes published: %v", err)
+			}
+		})
+	}
+}
+
+func TestContentPolicyResolveReturnsOnlyVerifiedAliases(t *testing.T) {
+	dir := t.TempDir()
