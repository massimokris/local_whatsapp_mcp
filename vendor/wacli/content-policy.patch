+	"testing"
+	"time"
+)
+
+func TestSyncCompletionAppStateSnapshotRecoversFailedLiveEvent(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	chat := types.NewJID("15551234567", types.DefaultUserServer)
+	ts := time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)
+	live := &events.Archive{JID: chat, Timestamp: ts, Action: &waSyncAction.ArchiveChatAction{Archived: proto.Bool(true)}}
+	raw, err := sql.Open("sqlite3", filepath.Join(a.opts.StoreDir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	if _, err = raw.Exec(`CREATE TRIGGER fail_event_archive BEFORE UPDATE OF archived ON chats BEGIN SELECT RAISE(FAIL, 'synthetic archive write failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	f.emit(live)
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("failed live write=%s", state)
+	}
+	if _, err = raw.Exec(`DROP TRIGGER fail_event_archive`); err != nil {
+		t.Fatal(err)
+	}
+	replay := *live
+	replay.FromFullSync = true
+	replay.Action = &waSyncAction.ArchiveChatAction{Archived: proto.Bool(false)}
+	replay.Timestamp = replay.Timestamp.Add(time.Minute)
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { return []any{&replay}, nil }
+	a.wa = client
+	if err = a.recoverAppStateCollection(t.Context(), string(appstate.WAPatchRegularLow), &sync.Map{}, time.Second); err != nil {
+		t.Fatal(err)
+	}
+	if required, err := a.db.AppStateRecoveryRequired(string(appstate.WAPatchRegularLow)); err != nil || required {
+		t.Fatalf("recovery not saved: required=%v error=%v", required, err)
+	}
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("successful full snapshot left sync=%s with %d debts", state, len(tracker.debts))
+	}
+}
+
+func failLiveArchive(t *testing.T, a *App, f *fakeWA) *events.Archive {
+	t.Helper()
+	evt := &events.Archive{JID: types.NewJID("15551234567", types.DefaultUserServer), Timestamp: time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC), Action: &waSyncAction.ArchiveChatAction{Archived: proto.Bool(true)}}
+	raw, err := sql.Open("sqlite3", filepath.Join(a.opts.StoreDir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	if _, err = raw.Exec(`CREATE TRIGGER fail_event_archive BEFORE UPDATE OF archived ON chats BEGIN SELECT RAISE(FAIL, 'synthetic archive write failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	f.emit(evt)
+	if _, err = raw.Exec(`DROP TRIGGER fail_event_archive`); err != nil {
+		t.Fatal(err)
+	}
+	return evt
+}
+func TestSyncCompletionSnapshotDebtRecoverySurvivesRestart(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	failLiveArchive(t, a, f)
+	tracker.mu.Lock()
+	var original uint64
+	for _, debt := range tracker.debts {
+		original = debt.Sequence
+	}
+	tracker.mu.Unlock()
+	next, err := a.startSyncCompletion(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	completionReady(f)
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { return nil, nil }
+	a.wa = client
+	if err = a.recoverAppStateCollection(t.Context(), string(appstate.WAPatchRegularLow), &sync.Map{}, time.Second); err != nil {
+		t.Fatal(err)
+	}
+	if state := completionState(t, next); state != "caught_up" {
+		t.Fatalf("restarted snapshot=%s", state)
+	}
+	_, work := next.begin(t.Context(), "new-work", "")
+	if next.debts["new-work"].Sequence <= original {
+		t.Fatal("restart reused journal generation")
+	}
+	work.finish(nil)
+}
+func TestSyncCompletionFailedOrUnrelatedSnapshotPreservesDebt(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	failLiveArchive(t, a, f)
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { return nil, nil }
+	a.wa = client
+	if fetchErr, persistErr := a.fetchAndPersistAppState(t.Context(), appstate.WAPatchRegularHigh, true, &appStatePersistenceTracker{}); fetchErr != nil || persistErr != nil {
+		t.Fatal(fetchErr, persistErr)
+	}
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("unrelated snapshot forgave debt=%s", state)
+	}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) {
+		return nil, errors.New("synthetic fetch failure")
+	}
+	if fetchErr, _ := a.fetchAndPersistAppState(t.Context(), appstate.WAPatchRegularLow, true, &appStatePersistenceTracker{}); fetchErr == nil {
+		t.Fatal("missing fetch failure")
+	}
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("failed snapshot forgave debt=%s", state)
+	}
+}
+func TestSyncCompletionSnapshotPreservesLaterFailureAndNonAppStateDebt(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	evt := failLiveArchive(t, a, f)
+	_, receipt := tracker.begin(t.Context(), "event:receipt", "", syncDebt{Kind: "Receipt"})
+	receipt.finish(errors.New("synthetic receipt failure"))
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchEvents = func(ctx context.Context, _ string, _ bool, _ bool) ([]any, error) {
+		newerCtx, newer := a.beginSyncEvent(ctx, evt)
+		recordSyncFailure(newerCtx, errors.New("later event failure"))
+		newer.finish(nil)
+		return nil, nil
+	}
+	a.wa = client
+	if fetchErr, persistErr := a.fetchAndPersistAppState(t.Context(), appstate.WAPatchRegularLow, true, &appStatePersistenceTracker{}); fetchErr != nil || persistErr != nil {
+		t.Fatal(fetchErr, persistErr)
+	}
+	tracker.mu.Lock()
+	defer tracker.mu.Unlock()
+	if len(tracker.debts) != 2 {
