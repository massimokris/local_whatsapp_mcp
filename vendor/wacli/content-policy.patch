+}
+func TestSyncCompletionEmptyBoundaryAndQuietSnapshots(t *testing.T) {
+	_, f, tracker, output := completionFixture(t)
+	completionReady(f)
+	if got := completionState(t, tracker); got != "caught_up" {
+		t.Fatalf("empty backlog=%s", got)
+	}
+	lines := strings.Split(strings.TrimSpace(output.String()), "\n")
+	connectedIndex, readyIndex := -1, -1
+	for i, line := range lines {
+		var event struct {
+			Event string `json:"event"`
+			Data  struct {
+				State string `json:"state"`
+			} `json:"data"`
+		}
+		if json.Unmarshal([]byte(line), &event) != nil {
+			continue
+		}
+		if event.Event == "connected" {
+			connectedIndex = i
+		}
+		if event.Event == "sync_state" && event.Data.State == "caught_up" {
+			readyIndex = i
+		}
+	}
+	if connectedIndex < 0 || readyIndex <= connectedIndex {
+		t.Fatalf("completion preceded connection: %s", output.String())
+	}
+	tracker.mu.Lock()
+	for range 3 {
+		tracker.emitLocked("sync_snapshot")
+	}
+	tracker.mu.Unlock()
+	if got := completionState(t, tracker); got != "caught_up" {
+		t.Fatalf("quiet snapshots=%s", got)
+	}
+}
+func TestSyncCompletionWaitsForReceiveAndOrderedWrites(t *testing.T) {
+	_, f, tracker, _ := completionFixture(t)
+	f.emit(&events.Connected{DeliveryConnectionID: 1})
+	f.emit(&events.DeliveryState{ConnectionID: 1, Received: 3, Pending: 1, Boundary: true})
+	if got := completionState(t, tracker); got != "syncing" {
+		t.Fatal(got)
+	}
+	_, work := tracker.begin(t.Context(), "pending-write", "")
+	finishWrite := work.hold()
+	work.finish(nil)
+	f.emit(&events.DeliveryState{ConnectionID: 1, Received: 3, Pending: 0, Boundary: true})
+	if got := completionState(t, tracker); got != "syncing" {
+		t.Fatalf("pending write=%s", got)
+	}
+	finishWrite(nil)
+	if got := completionState(t, tracker); got != "caught_up" {
+		t.Fatalf("saved work=%s", got)
+	}
+	_, work = tracker.begin(t.Context(), "later-history", "")
+	if got := completionState(t, tracker); got != "syncing" {
+		t.Fatalf("later history=%s", got)
+	}
+	work.finish(nil)
+	if got := completionState(t, tracker); got != "caught_up" {
+		t.Fatal(got)
+	}
+}
+func TestSyncCompletionDebtSurvivesRestartAndOnlyItsRecoveryClears(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	_, work := tracker.begin(t.Context(), "failed-download", "")
+	work.finish(errors.New("synthetic download failure"))
+	if got := completionState(t, tracker); got != "error" {
+		t.Fatalf("failed work=%s", got)
+	}
+	f.emit(&events.Disconnected{DeliveryConnectionID: 1})
+	f.emit(&events.Connected{DeliveryConnectionID: 2})
+	f.emit(&events.DeliveryState{ConnectionID: 2, Boundary: true})
+	if got := completionState(t, tracker); got != "error" {
+		t.Fatalf("reconnection forgave error=%s", got)
+	}
+	next, err := a.startSyncCompletion(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	next.receive(&events.DeliveryState{ConnectionID: 1, Boundary: true})
+	next.connectionEvent(1, true)
+	if got := completionState(t, next); got != "error" {
+		t.Fatalf("restart forgave debt=%s", got)
+	}
+	_, unrelated := next.begin(t.Context(), "unrelated-message", "")
+	unrelated.finish(nil)
+	if got := completionState(t, next); got != "error" {
+		t.Fatalf("unrelated work forgave debt=%s", got)
+	}
+	_, retry := next.begin(t.Context(), "failed-download", "")
+	if got := completionState(t, next); got != "error" {
+		t.Fatalf("pending retry forgave error=%s", got)
+	}
+	retry.finish(nil)
+	if got := completionState(t, next); got != "caught_up" {
+		t.Fatalf("successful recovery=%s", got)
+	}
+}
+func TestSyncCompletionHistoryWriteRecoversThroughLiveRetry(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	raw, err := sql.Open("sqlite3", filepath.Join(a.opts.StoreDir, "wacli.db"))
+	if err != nil {
