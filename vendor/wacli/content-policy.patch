+func completionState(t *testing.T, tracker *syncCompletion) string {
+	t.Helper()
+	tracker.mu.Lock()
+	defer tracker.mu.Unlock()
+	return tracker.stateLocked()
+}
+func completionReady(f *fakeWA) {
+	f.emit(&events.DeliveryState{ConnectionID: 1, Received: 1, Boundary: true})
