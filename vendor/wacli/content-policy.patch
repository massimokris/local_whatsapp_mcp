+	}
+	selected := types.NewJID("15551234567", types.DefaultUserServer)
+	f.emit(&events.UndecryptableMessage{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: selected, Sender: selected}, ID: "decrypt-retry"}})
+	if got := completionState(t, tracker); got != "error" {
