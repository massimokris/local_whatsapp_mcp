+func TestContentPolicyMustLoadBeforeOpeningStore(t *testing.T) {
+	for _, body := range []string{"", `{}`, `{"version":2,"revision":1,"mode":"all"}`, `{"version":1,"revision":1,"mode":"typo"}`, `{"version":1,"revision":1,"mode":"selected","chat_ids":["invalid"]}`} {
+		t.Run(body, func(t *testing.T) {
+			dir := t.TempDir()
+			policy := filepath.Join(dir, "policy.json")
+			if body != "" {
+				if err := os.WriteFile(policy, []byte(body), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if a, err := New(Options{StoreDir: filepath.Join(dir, "store"), ContentPolicyPath: policy}); err == nil {
+				a.Close()
+				t.Fatal("invalid required policy opened store")
+			}
+			if _, err := os.Stat(filepath.Join(dir, "store")); !os.IsNotExist(err) {
+				t.Fatalf("store created before policy validation: %v", err)
+			}
+		})
+	}
+	var events bytes.Buffer
+	dir := t.TempDir()
+	policy := filepath.Join(dir, "policy.json")
+	if err := os.WriteFile(policy, []byte(`{"version":1,"revision":17,"mode":"selected","chat_ids":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	a, err := New(Options{StoreDir: filepath.Join(dir, "store"), ContentPolicyPath: policy, Events: out.NewEventWriter(&events, true)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	if !strings.Contains(events.String(), `"event":"policy_loaded"`) || !strings.Contains(events.String(), `"revision":17`) {
+		t.Fatalf("missing policy acknowledgement: %s", events.String())
+	}
+}
+
+func TestContentPolicySyncRetainsCatalogButSkipsExcludedPayloads(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "policy.json")
+	if err := os.WriteFile(path, []byte(`{"version":1,"revision":1,"mode":"selected","chat_ids":["111@s.whatsapp.net"]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	a, err := New(Options{StoreDir: filepath.Join(dir, "store"), ContentPolicyPath: path})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	f := newFakeWA()
+	a.wa = f
+	allowed := types.NewJID("111", types.DefaultUserServer)
+	excluded := types.NewJID("222", types.DefaultUserServer)
+	base := time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+	live := func(chat types.JID, id string) *events.Message {
+		return &events.Message{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: chat}, ID: id, Timestamp: base}, Message: &waProto.Message{Conversation: proto.String("synthetic retained content")}}
+	}
+	f.connectEvents = []any{live(allowed, "allowed"), live(excluded, "excluded"), historySyncWithTextMessages(excluded, base, "late-history")}
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	res, err := a.Sync(ctx, SyncOptions{Mode: SyncModeFollow, AfterConnect: func(context.Context) error { cancel(); return nil }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.MessagesStored != 1 {
+		t.Fatalf("stored %d messages, want 1", res.MessagesStored)
+	}
+	if n, err := a.DB().CountMessages(); err != nil || n != 1 {
+		t.Fatalf("archive count %d, error %v", n, err)
+	}
+	if _, err := a.DB().GetMessage(excluded.String(), "excluded"); !errors.Is(err, sql.ErrNoRows) {
+		t.Fatalf("excluded content persisted: %v", err)
+	}
+	catalog, err := a.DB().GetChat(excluded.String())
+	if err != nil || catalog.LastMessageTS.IsZero() {
+		t.Fatalf("excluded catalog missing activity: %+v / %v", catalog, err)
+	}
