+func TestContentPolicyRejectsCachedMediaBeforeCopy(t *testing.T) {
+	dir := t.TempDir()
+	db, err := store.Open(filepath.Join(dir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	chat := "111@s.whatsapp.net"
+	data := []byte("synthetic private media")
+	hash := sha256.Sum256(data)
+	cached := filepath.Join(dir, "cached")
+	if err := os.WriteFile(cached, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.UpsertChat(chat, "dm", "Synthetic", time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.UpsertMessage(store.UpsertMessageParams{ChatJID: chat, MsgID: "old", Timestamp: time.Now(), MediaType: "audio", DirectPath: "expired", MediaKey: make([]byte, 32), FileSHA256: hash[:], FileLength: uint64(len(data))}); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.MarkMediaDownloaded(chat, "old", cached, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+	policy := filepath.Join(dir, "policy.json")
+	if err := os.WriteFile(policy, []byte(`{"version":1,"revision":2,"mode":"selected","chat_ids":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"read-only", "writable"} {
+		t.Run(mode, func(t *testing.T) {
+			target := filepath.Join(dir, "output-"+mode)
+			args := []string{"--store", dir, "--content-policy", policy, "--json", "media", "download", "--chat", chat, "--id", "old", "--output", target}
+			if mode == "read-only" {
+				args = append([]string{"--read-only"}, args...)
+			}
+			stdout, stderr, err := runPresenceDelegateHelper(t, args)
+			if err == nil || !strings.Contains(stderr, "content excluded") {
+				t.Fatalf("excluded cache result error=%v out=%s err=%s", err, stdout, stderr)
+			}
+			if _, err := os.Stat(target); !os.IsNotExist(err) {
+				t.Fatalf("excluded bytes published: %v", err)
+			}
+		})
+	}
+}
+
+func TestContentPolicyResolveReturnsOnlyVerifiedAliases(t *testing.T) {
+	dir := t.TempDir()
+	db, err := store.Open(filepath.Join(dir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+	writeTestSessionLIDMap(t, filepath.Join(dir, "session.db"), "999123456789", "15551234567")
+	policy := filepath.Join(dir, "policy.json")
+	if err := os.WriteFile(policy, []byte(`{"version":1,"revision":2,"mode":"selected","chat_ids":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		chat string
+		want []string
+	}{
+		{"15551234567:2@s.whatsapp.net", []string{"15551234567@s.whatsapp.net", "999123456789@lid"}},
+		{"999123456789@lid", []string{"999123456789@lid", "15551234567@s.whatsapp.net"}},
+		{"777@lid", []string{"777@lid"}},
+		{"123-456@g.us", []string{"123-456@g.us"}},
+	} {
+		t.Run(tc.chat, func(t *testing.T) {
+			stdout, stderr, err := runPresenceDelegateHelper(t, []string{"--store", dir, "--content-policy", policy, "--read-only", "--json", "policy", "resolve", "--chat", tc.chat})
+			if err != nil {
+				t.Fatalf("resolve failed %v out=%s err=%s", err, stdout, stderr)
+			}
+			var envelope struct {
+				Data struct {
+					ChatIDs []string            `json:"chat_ids"`
+					Groups  map[string][]string `json:"groups"`
+				} `json:"data"`
+			}
+			decoder := json.NewDecoder(strings.NewReader(stdout))
+			if err := decoder.Decode(&envelope); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(envelope.Data.ChatIDs, tc.want) {
+				t.Fatalf("aliases=%v want %v", envelope.Data.ChatIDs, tc.want)
+			}
+		})
+	}
+	t.Run("batch unions verified aliases once", func(t *testing.T) {
+		args := []string{"--store", dir, "--content-policy", policy, "--read-only", "--json", "policy", "resolve"}
+		for _, chat := range []string{"15551234567:2@s.whatsapp.net", "999123456789@lid", "777@lid", "123-456@g.us", "777@lid"} {
+			args = append(args, "--chat", chat)
+		}
+		stdout, stderr, err := runPresenceDelegateHelper(t, args)
+		if err != nil {
+			t.Fatalf("resolve batch failed %v out=%s err=%s", err, stdout, stderr)
+		}
+		var envelope struct {
+			Data struct {
+				ChatIDs []string            `json:"chat_ids"`
+				Groups  map[string][]string `json:"groups"`
+			} `json:"data"`
+		}
+		if err := json.NewDecoder(strings.NewReader(stdout)).Decode(&envelope); err != nil {
+			t.Fatal(err)
+		}
+		want := []string{"15551234567@s.whatsapp.net", "999123456789@lid", "777@lid", "123-456@g.us"}
+		if !reflect.DeepEqual(envelope.Data.ChatIDs, want) {
+			t.Fatalf("batch aliases=%v want %v", envelope.Data.ChatIDs, want)
+		}
+		if !reflect.DeepEqual(envelope.Data.Groups["15551234567@s.whatsapp.net"], []string{"15551234567@s.whatsapp.net", "999123456789@lid"}) || !reflect.DeepEqual(envelope.Data.Groups["777@lid"], []string{"777@lid"}) {
+			t.Fatalf("identity groups must preserve verified membership: %v", envelope.Data.Groups)
+		}
+	})
+	assertNoSQLiteSidecars(t, filepath.Join(dir, "session.db"))
+}
+
+func TestContentPolicyOwnerPipeClosureStopsWriterContext(t *testing.T) {
+	reader, writer := io.Pipe()
+	defer reader.Close()
+	defer writer.Close()
+	var events bytes.Buffer
+	ctx, stop := signalContextWithOwner(out.NewEventWriter(&events, true), reader)
+	defer stop()
+	select {
+	case <-ctx.Done():
+		t.Fatal("writer stopped while owner was alive")
+	default:
+	}
+	if _, err := writer.Write([]byte("keep ownership")); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("orphan writer context remained active")
+	}
+	if !strings.Contains(events.String(), `"event":"owner_lost"`) {
+		t.Fatalf("missing owner-lost event: %s", events.String())
+	}
+}
+
+func TestContentPolicyRejectsOutboundTextAndFilesBeforeTransport(t *testing.T) {
+	dir := t.TempDir()
+	policy := filepath.Join(dir, "policy.json")
+	if err := os.WriteFile(policy, []byte(`{"version":1,"revision":2,"mode":"selected","chat_ids":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	a, err := app.New(app.Options{StoreDir: filepath.Join(dir, "store"), ContentPolicyPath: policy})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	to := types.NewJID("222", types.DefaultUserServer)
+	// No transport is installed: rejection must precede client/file access.
+	if _, _, err := sendTextWithHistory(t.Context(), a, nil, to, "synthetic body", "", "", nil, nil, textEphemeralOptions{}, textSendOptions{}); err == nil || !strings.Contains(err.Error(), "content excluded") {
+		t.Fatalf("text dispatch not denied: %v", err)
+	}
+	if _, err := sendFile(t.Context(), a, to, filepath.Join(dir, "must-not-read"), sendFileOptions{}); err == nil || !strings.Contains(err.Error(), "content excluded") {
+		t.Fatalf("file dispatch not denied: %v", err)
+	}
+}
