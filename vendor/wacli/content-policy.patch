+package main
+
+import (
+	"crypto/sha256"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/lock"
+	"github.com/openclaw/wacli/internal/store"
+)
+
+func TestMediaCacheOnlyNeverNeedsSessionOrWriter(t *testing.T) {
+	for _, state := range []string{"verified", "missing", "corrupt"} {
+		for _, readOnly := range []bool{true, false} {
+			t.Run(state+map[bool]string{true: "/read-only", false: "/writable"}[readOnly], func(t *testing.T) {
+				dir := t.TempDir()
+				db, err := store.Open(filepath.Join(dir, "wacli.db"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				chat, id := "111@s.whatsapp.net", "cache-only"
+				content := []byte("verified offline attachment")
+				hash := sha256.Sum256(content)
+				if err := db.UpsertChat(chat, "dm", "Synthetic", time.Now()); err != nil {
+					t.Fatal(err)
+				}
+				if err := db.UpsertMessage(store.UpsertMessageParams{ChatJID: chat, MsgID: id, SenderJID: chat, Timestamp: time.Now(), MediaType: "document", MimeType: "text/plain", DirectPath: "invalid-location-that-must-not-be-used", MediaKey: make([]byte, 32), FileSHA256: hash[:], FileLength: uint64(len(content))}); err != nil {
+					t.Fatal(err)
+				}
+				cache := filepath.Join(dir, "cached.txt")
+				if state != "missing" {
+					data := content
+					if state == "corrupt" {
+						data = []byte("corrupt or interrupted download")
+					}
+					if err := os.WriteFile(cache, data, 0600); err != nil {
+						t.Fatal(err)
+					}
+					if err := db.MarkMediaDownloaded(chat, id, cache, time.Now()); err != nil {
+						t.Fatal(err)
+					}
+				}
+				db.Close()
+				lk, err := lock.Acquire(dir)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer lk.Release()
+				target := filepath.Join(dir, "output.txt")
+				args := []string{"--store", dir, "--json", "--timeout", "2s", "media", "download", "--chat", chat, "--id", id, "--output", target, "--cache-only"}
+				if readOnly {
+					args = append([]string{"--read-only"}, args...)
+				}
+				stdout, stderr, err := runPresenceDelegateHelper(t, args)
+				if state == "verified" {
+					if err != nil || !strings.Contains(stdout, `"source":"cache"`) {
+						t.Fatalf("verified cache rejected: %v stdout=%s stderr=%s", err, stdout, stderr)
+					}
+					if data, err := os.ReadFile(target); err != nil || string(data) != string(content) {
+						t.Fatal("incorrect cached output", err)
+					}
+				} else {
+					if err == nil || !strings.Contains(stdout+stderr, "media_not_cached") {
+						t.Fatalf("cache miss did not stop before network/auth: %v stdout=%s stderr=%s", err, stdout, stderr)
+					}
+					if _, err := os.Stat(target); !os.IsNotExist(err) {
+						t.Fatal("cache miss published output", err)
+					}
+				}
+				if _, err := os.Stat(filepath.Join(dir, "session.db")); !os.IsNotExist(err) {
+					t.Fatal("cache-only opened a session", err)
+				}
+			})
+		}
+	}
+}
+
+func TestMediaCacheOnlyRejectsPhoneRecovery(t *testing.T) {
+	err := execute([]string{"--store", t.TempDir(), "media", "download", "--chat", "111@s.whatsapp.net", "--id", "fixture", "--cache-only", "--retry-on-phone"})
+	if err == nil || !strings.Contains(err.Error(), "--cache-only") {
+		t.Fatal("cache-only accepted phone recovery", err)
+	}
+}
