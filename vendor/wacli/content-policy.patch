+package app
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/openclaw/wacli/internal/wa"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+// A delivery boundary and a durable application work journal serve different
+// purposes: the former orders network receives; the latter survives a failed
+// download/write and cannot be forgiven just by opening a fresh socket.
+type syncDebt struct {
+	Chat   string `json:"chat,omitempty"`
+	Failed bool   `json:"failed,omitempty"`
+}
+type syncCompletion struct {
+	mu                  sync.Mutex
+	app                 *App
+	runID               string
+	revision            int64
+	connection          uint64
+	connectionVersion   uint64
+	connected, boundary bool
+	ended               bool
+	pending             uint64
+	active              int
+	debts               map[string]syncDebt
+	activeKeys          map[string]int
+	journalFailed       bool
+	lastState           string
+	path                string
+}
+type syncWorkContextKey struct{}
+type syncWork struct {
+	tracker *syncCompletion
+	key     string
+	mu      sync.Mutex
+	refs    int
+	failed  bool
+}
+
+func (a *App) startSyncCompletion(ctx context.Context) (*syncCompletion, error) {
+	if a.contentPolicy == nil {
+		return nil, nil
+	}
+	t := &syncCompletion{app: a, runID: os.Getenv("WACLI_SYNC_RUN_ID"), debts: map[string]syncDebt{}, activeKeys: map[string]int{}, path: filepath.Join(a.opts.StoreDir, "sync-debts.json")}
+	if a.contentPolicy != nil {
+		t.revision = a.contentPolicy.Revision
+	}
+	body, err := os.ReadFile(t.path)
+	if err == nil {
+		if json.Unmarshal(body, &t.debts) != nil || t.debts == nil {
+			return nil, errors.New("sync recovery journal is unreadable; preserve the archive and repair its sync-debts.json file")
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, err
+	}
+	for key, debt := range t.debts {
+		if debt.Chat != "" && a.CheckContentScope(ctx, debt.Chat) != nil {
+			delete(t.debts, key)
+		}
+	}
+	if err := t.saveLocked(); err != nil {
+		return nil, errors.New("sync recovery journal cannot be saved; check its file permissions")
+	}
+	a.syncCompletionMu.Lock()
+	a.syncCompletion = t
+	a.syncCompletionMu.Unlock()
+	t.mu.Lock()
+	t.emitLocked("sync_state")
+	t.mu.Unlock()
+	go func() {
+		ticker := time.NewTicker(5 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				t.snapshot(func() bool { return a.wa != nil && a.wa.IsConnected() && a.wa.IsAuthed() })
+			}
+		}
+	}()
+	return t, nil
+}
+
+// Connection checks acquire upstream socket locks, so run them outside the
+// completion mutex. A sample may only invalidate the exact connection state it
+// observed; an intervening Connected event must not be erased by an older read.
+func (t *syncCompletion) snapshot(healthy func() bool) {
+	t.mu.Lock()
+	version, wasConnected := t.connectionVersion, t.connected
+	t.mu.Unlock()
+	connectionHealthy := true
+	if wasConnected {
+		connectionHealthy = healthy()
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if wasConnected && !connectionHealthy && version == t.connectionVersion {
+		t.connectionVersion++
+		t.connected = false
+		t.ended = true
+		t.boundary = false
+		t.app.emitOrPrint("connection_check_failed", map[string]any{"run_id": t.runID, "revision": t.revision, "connection_id": t.connection}, "\nWhatsApp connection check failed.\n")
+		t.emitLocked("sync_state")
+	}
+	t.emitLocked("sync_snapshot")
+}
+
+func (t *syncCompletion) stateLocked() string {
+	if t.journalFailed {
+		return "error"
+	}
+	for key, debt := range t.debts {
+		if debt.Failed || t.activeKeys[key] == 0 {
+			return "error"
+		}
+	}
+	if !t.connected {
+		return "unknown"
+	}
+	if !t.boundary || t.pending > 0 || t.active > 0 {
+		return "syncing"
+	}
+	return "caught_up"
+}
+func (t *syncCompletion) dataLocked() map[string]any {
+	return map[string]any{"run_id": t.runID, "revision": t.revision, "connection_id": t.connection, "state": t.stateLocked()}
+}
+func (t *syncCompletion) emitLocked(event string) {
+	if event == "sync_state" && t.connected && t.boundary && t.pending == 0 && t.active == 0 && !t.journalFailed {
+		ready := true
+		for key := range t.debts {
+			if key != "sync-marker" {
+				ready = false
+				break
+			}
+		}
+		if ready {
+			if err := t.app.db.RecordSuccessfulSync(nowUTC()); err != nil {
+				t.debts["sync-marker"] = syncDebt{Failed: true}
+				if t.saveLocked() != nil {
+					t.journalFailed = true
+				}
+			} else if _, exists := t.debts["sync-marker"]; exists {
+				delete(t.debts, "sync-marker")
+				if t.saveLocked() != nil {
+					t.journalFailed = true
+				}
+			}
+		}
+	}
+	state := t.stateLocked()
+	if event == "sync_state" && state == t.lastState {
+		return
+	}
+	data := t.dataLocked()
+	data["state"] = state
+	t.app.emitEvent(event, data)
+	if event == "sync_state" {
+		t.lastState = state
+	}
+}
+
+func (t *syncCompletion) receive(v *events.DeliveryState) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if v.ConnectionID < t.connection || (v.ConnectionID == t.connection && t.ended) {
+		return
+	}
+	if v.ConnectionID > t.connection {
+		t.connectionVersion++
+		t.connection = v.ConnectionID
+		t.ended = false
+		t.connected = false
+		t.boundary = false
+		t.lastState = ""
+	}
+	t.pending = v.Pending
+	t.boundary = v.Boundary
+	if v.Failed {
+		t.debts["receive-decode"] = syncDebt{Failed: true}
+		if t.saveLocked() != nil {
+			t.journalFailed = true
+		}
+	}
+	t.emitLocked("sync_state")
+}
+func (t *syncCompletion) connectionEvent(id uint64, connected bool) map[string]any {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if id >= t.connection && !(id == t.connection && t.ended && connected) {
+		t.connectionVersion++
+		if id > t.connection {
+			t.connection = id
+			t.ended = false
+			t.boundary = false
+			t.pending = 0
+			t.lastState = ""
+		}
+		t.connected = connected
+		if !connected {
+			t.ended = true
+			t.boundary = false
+		}
+		if connected {
+			t.app.emitOrPrint("connected", map[string]any{"run_id": t.runID, "revision": t.revision, "connection_id": id}, "\nConnected.\n")
+		} else {
+			t.app.emitOrPrint("disconnected", map[string]any{"run_id": t.runID, "revision": t.revision, "connection_id": id}, "\nDisconnected.\n")
+		}
+		t.emitLocked("sync_state")
+	}
+	return map[string]any{"run_id": t.runID, "revision": t.revision, "connection_id": id}
+}
+func (t *syncCompletion) saveLocked() error {
+	body, err := json.Marshal(t.debts)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(t.path), ".sync-debts-")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if err = f.Chmod(0600); err == nil {
+		_, err = f.Write(body)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = os.Rename(name, t.path)
+	}
+	if err == nil {
+		dir, openErr := os.Open(filepath.Dir(t.path))
+		if openErr != nil {
+			return openErr
+		}
+		err = dir.Sync()
+		closeErr := dir.Close()
+		if err == nil {
+			err = closeErr
+		}
+	}
+	return err
+}
+func (t *syncCompletion) begin(ctx context.Context, key, chat string) (context.Context, *syncWork) {
+	if key == "" {
+		return ctx, nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.active++
+	t.activeKeys[key]++
+	debt := t.debts[key]
+	debt.Chat = chat
+	t.debts[key] = debt
+	w := &syncWork{tracker: t, key: key, refs: 1}
+	if t.saveLocked() != nil {
+		t.journalFailed = true
+		w.failed = true
+	} else {
+		t.journalFailed = false
+	}
+	t.emitLocked("sync_state")
+	return context.WithValue(ctx, syncWorkContextKey{}, w), w
+}
+func (w *syncWork) hold() func(error) {
+	if w == nil {
+		return func(error) {}
+	}
+	w.mu.Lock()
+	w.refs++
+	w.mu.Unlock()
+	return func(err error) { w.finish(err) }
+}
+func (w *syncWork) finish(err error) {
+	if w == nil {
+		return
+	}
+	w.mu.Lock()
+	if err != nil {
+		w.failed = true
+	}
+	w.refs--
+	if w.refs > 0 {
+		w.mu.Unlock()
+		return
+	}
+	failed := w.failed
+	w.mu.Unlock()
+	t := w.tracker
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.active--
+	t.activeKeys[w.key]--
+	if failed {
+		debt := t.debts[w.key]
+		debt.Failed = true
+		t.debts[w.key] = debt
+	} else if t.activeKeys[w.key] == 0 {
+		delete(t.debts, w.key)
+	}
+	if t.saveLocked() != nil {
+		t.journalFailed = true
+	} else {
+		t.journalFailed = false
+	}
+	t.emitLocked("sync_state")
+}
+func syncWorkFrom(ctx context.Context) *syncWork {
+	w, _ := ctx.Value(syncWorkContextKey{}).(*syncWork)
+	return w
+}
+func recordSyncFailure(ctx context.Context, err error) {
+	if err == nil || errors.Is(err, errContentSkipped) {
+		return
+	}
+	if w := syncWorkFrom(ctx); w != nil {
+		w.mu.Lock()
+		w.failed = true
+		w.mu.Unlock()
+	}
+}
+func (a *App) emitSyncWarning(ctx context.Context, code, message string, data map[string]any) {
+	if (strings.HasSuffix(code, "_failed") && code != "history_delete_failed" && code != "send_presence_failed") || strings.HasPrefix(code, "encrypted_edit_") {
+		recordSyncFailure(ctx, errors.New(code))
+	}
+	a.emitWarning(code, message, data)
+}
+func hashSyncProto(value proto.Message) string {
+	body, _ := proto.MarshalOptions{Deterministic: true}.Marshal(value)
+	sum := sha256.Sum256(body)
+	return hex.EncodeToString(sum[:])
+}
+func (a *App) beginSyncEvent(ctx context.Context, evt any) (context.Context, *syncWork) {
+	a.syncCompletionMu.Lock()
+	t := a.syncCompletion
+	a.syncCompletionMu.Unlock()
+	if t == nil {
+		return ctx, nil
+	}
+	var key, chat string
+	switch v := evt.(type) {
+	case *events.Message:
+		if n := historySyncNotificationFromMessage(v); n != nil {
+			key = "history:" + hashSyncProto(n)
+		} else {
+			chat = canonicalJIDString(a.canonicalStoreJID(ctx, v.Info.Chat))
+			if a.CheckContentScope(ctx, chat) != nil {
+				return ctx, nil
+			}
+			key = "message:" + chat + ":" + string(v.Info.ID)
+		}
+	case *events.AppStateSyncError:
+		key = "app-state-recovery:" + string(v.Name)
+	case *events.HistorySync:
+		key = "history-data:" + hashSyncProto(v.Data)
+	case *events.UndecryptableMessage:
+		chat = canonicalJIDString(a.canonicalStoreJID(ctx, v.Info.Chat))
+		if a.CheckContentScope(ctx, chat) != nil {
+			return ctx, nil
+		}
+		key = "message:" + chat + ":" + string(v.Info.ID)
+	case *events.CallOffer, *events.CallAccept, *events.CallPreAccept, *events.CallTransport, *events.CallOfferNotice, *events.CallRelayLatency, *events.CallTerminate, *events.CallReject,
+		*events.AppState, *events.Star, *events.DeleteForMe, *events.Archive, *events.UnarchiveChatsSetting, *events.Pin, *events.Mute, *events.MarkChatAsRead, *events.Contact, *events.Receipt:
+		body, _ := json.Marshal(evt)
+		sum := sha256.Sum256(body)
+		key = "event:" + hex.EncodeToString(sum[:])
+	}
+	return t.begin(ctx, key, chat)
+}
+
+// Mutations of an existing row carry their own recovery identity: replaying the
+// old original message cannot recover an edit that was never saved.
+func (a *App) parsedSyncKey(ctx context.Context, pm wa.ParsedMessage) string {
+	key := "message:" + canonicalJIDString(a.canonicalStoreJID(ctx, pm.Chat)) + ":" + pm.ID
+	if pm.Edited || pm.Revoked {
+		body, _ := json.Marshal(struct {
+			Edited, Revoked bool
+			Text            string
+			Media           *wa.Media
+			Location        *wa.Location
+			Buttons         []wa.Button
+		}{pm.Edited, pm.Revoked, pm.Text, pm.Media, pm.Location, pm.Buttons})
+		sum := sha256.Sum256(body)
+		key += ":mutation:" + hex.EncodeToString(sum[:])
+	}
+	return key
+}
+func (a *App) beginParsedSyncWork(ctx context.Context, pm wa.ParsedMessage) (context.Context, *syncWork) {
+	a.syncCompletionMu.Lock()
+	t := a.syncCompletion
+	a.syncCompletionMu.Unlock()
+	key := a.parsedSyncKey(ctx, pm)
+	current := syncWorkFrom(ctx)
+	if t != nil && (current == nil || current.key != key) && a.CheckContentScope(ctx, pm.Chat.String()) == nil {
+		return t.begin(ctx, key, canonicalJIDString(a.canonicalStoreJID(ctx, pm.Chat)))
+	}
+	return ctx, nil
+}
