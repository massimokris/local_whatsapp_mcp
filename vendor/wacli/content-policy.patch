+
+func TestContentPolicyOwnerPipeClosureStopsWriterContext(t *testing.T) {
+	reader, writer := io.Pipe()
+	defer reader.Close()
+	defer writer.Close()
+	var events bytes.Buffer
+	ctx, stop := signalContextWithOwner(out.NewEventWriter(&events, true), reader)
+	defer stop()
+	select {
+	case <-ctx.Done():
+		t.Fatal("writer stopped while owner was alive")
+	default:
+	}
+	if _, err := writer.Write([]byte("keep ownership")); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("orphan writer context remained active")
+	}
+	if !strings.Contains(events.String(), `"event":"owner_lost"`) {
+		t.Fatalf("missing owner-lost event: %s", events.String())
+	}
+}
