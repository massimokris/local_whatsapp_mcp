+		t.Fatal(err)
+	}
+}
+
+func TestSyncCompletionEndedGenerationCannotReopen(t *testing.T) {
+	_, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	f.emit(&events.Disconnected{DeliveryConnectionID: 1})
+	f.emit(&events.DeliveryState{ConnectionID: 1, Boundary: true})
+	f.emit(&events.Connected{DeliveryConnectionID: 1})
+	if got := completionState(t, tracker); got != "unknown" {
+		t.Fatalf("ended connection reopened=%s", got)
+	}
+	f.emit(&events.Connected{DeliveryConnectionID: 2})
+	f.emit(&events.DeliveryState{ConnectionID: 2, Boundary: true})
+	if got := completionState(t, tracker); got != "caught_up" {
+		t.Fatal(got)
+	}
+}
+func TestSyncCompletionFailedEditNeedsItsActualRecovery(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	f.emit(offlineTestMessage("edit-target"))
+	raw, err := sql.Open("sqlite3", filepath.Join(a.opts.StoreDir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	if _, err = raw.Exec(`CREATE TRIGGER fail_completion_edit BEFORE INSERT ON messages BEGIN SELECT RAISE(FAIL, 'synthetic edit failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	edited := wa.ParseLiveMessage(offlineTestMessage("edit-target"))
+	edited.Edited = true
+	edited.Text = "Updated synthetic text"
+	if err = a.storeParsedMessageForSync(t.Context(), edited, messageStoreOptions{}); err == nil {
+		t.Fatal("edit unexpectedly saved")
+	}
+	if _, err = raw.Exec(`DROP TRIGGER fail_completion_edit`); err != nil {
+		t.Fatal(err)
+	}
+	f.emit(offlineTestMessage("edit-target"))
+	if got := completionState(t, tracker); got != "error" {
+		t.Fatalf("original replay forgave missing edit=%s", got)
+	}
+	if err = a.storeParsedMessageForSync(t.Context(), edited, messageStoreOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	if got := completionState(t, tracker); got != "caught_up" {
+		t.Fatalf("actual edit recovery=%s", got)
+	}
+}
