+	f.emit(offlineTestMessage("unrelated"))
+	if got := completionState(t, tracker); got != "error" {
+		t.Fatalf("unrelated write=%s", got)
+	}
+	f.emit(offlineTestMessage("retry-message"))
+	if got := completionState(t, tracker); got != "caught_up" {
+		t.Fatalf("recovered history message=%s debts=%+v", got, tracker.debts)
+	}
+}
+func TestSyncCompletionSelectedUndecryptableAndHistoryDownload(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	a.contentPolicy.Mode = "selected"
+	a.contentPolicy.ChatIDs = []string{"15551234567@s.whatsapp.net"}
