+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestSyncUsesUpstreamMessagesAndIgnoresLegacyCompletionJournal(t *testing.T) {
+	for _, legacy := range []bool{false, true} {
+		name := "fresh"
+		if legacy {
+			name = "legacy_unreadable"
+		}
+		t.Run(name, func(t *testing.T) {
+			a, base := policyTestApp(t, "initial", `[]`)
+			journal := filepath.Join(a.StoreDir(), "sync-debts.json")
+			if legacy {
+				if err := os.WriteFile(journal, []byte("unreadable legacy journal"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var output bytes.Buffer
+			a.opts.Events = out.NewEventWriter(&output, true)
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			f := &handshakeWA{fakeWA: base}
+			a.wa = f
+			f.connect = func(context.Context, wa.ConnectOptions) error {
+				base.authed, base.connected = true, true
+				base.emit(&events.PairSuccess{})
+				base.emit(&events.Connected{})
+				base.emit(offlineTestMessage("synthetic-normal-message"))
+				return nil
+			}
+			_, err := a.Sync(ctx, SyncOptions{Mode: SyncModeFollow, AllowQR: true, AfterConnect: func(context.Context) error { cancel(); return nil }})
+			if err != nil {
+				t.Fatalf("legacy tracking blocked normal sync: %v", err)
+			}
+			if count, err := a.db.CountMessages(); err != nil || count != 1 {
+				t.Fatalf("message storage count=%d err=%v", count, err)
+			}
+			if strings.Contains(output.String(), `"event":"sync_state"`) || strings.Contains(output.String(), `"event":"sync_snapshot"`) {
+				t.Fatal("custom completion events remain")
+			}
+			body, err := os.ReadFile(journal)
+			if legacy {
+				if err != nil || string(body) != "unreadable legacy journal" {
+					t.Fatal("legacy journal changed", err)
+				}
+			} else if !os.IsNotExist(err) {
+				t.Fatal("custom journal was created", err)
+			}
+		})
+	}
+}
