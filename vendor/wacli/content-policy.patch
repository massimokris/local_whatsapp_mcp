@@ -0,0 +1,295 @@
+package app
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"go.mau.fi/whatsmeow/appstate"
