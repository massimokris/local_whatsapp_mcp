+	}
+	a.contentPolicy = &contentPolicy{Version: 1, Revision: 7, Mode: "selected", ChatIDs: []string{group.String()}, allowed: map[string]struct{}{group.String(): {}}}
+	for _, chat := range []types.JID{group, other} {
+		_, w := tracker.begin(t.Context(), "message:"+chat.String()+":synthetic-missing", chat.String())
+		w.finish(errors.New("synthetic unavailable"))
+	}
+	client := &repairRequestWA{fakeWA: f}
+	a.wa = client
+	if err := a.repairPendingSync(t.Context()); err != nil {
+		t.Fatal(err)
+	}
+	if len(client.requests) != 1 || client.requests[0].Chat != group || len(client.senders) != 1 || len(client.senders[0]) != 2 || client.senders[0][0] != lid || client.senders[0][1] != allowed {
+		t.Fatalf("unexpected scoped participant requests=%+v senders=%+v", client.requests, client.senders)
+	}
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("request metadata cleared original failures: %s", state)
+	}
+}
