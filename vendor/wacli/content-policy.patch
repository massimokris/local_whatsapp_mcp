+		t.Fatal(err)
+	}
+	chat := types.NewJID("15551234567", types.DefaultUserServer)
+	f.emit(historySyncWithTextMessages(chat, time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC), "retry-message"))
+	if got := completionState(t, tracker); got != "error" {
