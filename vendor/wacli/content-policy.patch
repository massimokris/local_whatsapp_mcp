diff --git a/internal/app/content_policy.go b/internal/app/content_policy.go
new file mode 100644
index 0000000..0ed0dfa
--- /dev/null
+++ b/internal/app/content_policy.go
@@ -0,0 +1,95 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// contentPolicy is immutable for one process. The supervisor must stop and
+// await every old writer before atomically replacing the file and restarting.
+type contentPolicy struct {
+	allowed  map[string]struct{}
+	Version  int      `json:"version"`
+	Revision int64    `json:"revision"`
+	Mode     string   `json:"mode"`
+	ChatIDs  []string `json:"chat_ids"`
+}
+
+func loadContentPolicy(path string) (*contentPolicy, error) {
+	if path == "" {
+		return nil, nil
+	} // Preserve standalone upstream behavior.
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("content policy cannot be opened")
+	}
+	defer file.Close()
+	var p contentPolicy
+	decoder := json.NewDecoder(io.LimitReader(file, 4<<20))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&p); err != nil {
+		return nil, fmt.Errorf("content policy is invalid")
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return nil, fmt.Errorf("content policy has trailing data")
+	}
+	if p.Version != 1 || p.Revision < 1 {
+		return nil, fmt.Errorf("content policy version or revision is invalid")
+	}
+	if p.Mode != "initial" && p.Mode != "all" && p.Mode != "selected" {
+		return nil, fmt.Errorf("content policy mode is invalid")
+	}
+	p.allowed = make(map[string]struct{}, len(p.ChatIDs))
+	for _, raw := range p.ChatIDs {
+		jid, err := types.ParseJID(raw)
+		if err != nil || jid.IsEmpty() || strings.TrimSpace(raw) != raw || jid.User == "" || (jid.Server != types.DefaultUserServer && jid.Server != types.HiddenUserServer && jid.Server != types.GroupServer) {
+			return nil, fmt.Errorf("content policy contains an invalid chat identity")
+		}
+		p.allowed[jid.ToNonAD().String()] = struct{}{}
+	}
+	return &p, nil
+}
+
+// errContentSkipped distinguishes intentional exclusion from successful content
+// storage and from a persistence failure. Callers must not emit content side
+// effects or count a skipped message as retained.
+var errContentSkipped = errors.New("content excluded by chat scope")
+
+// CheckContentScope gates bytes before cache access, downloads, and retries.
+// Read-only callers use the existing read-only session identity resolver.
+func (a *App) CheckContentScope(ctx context.Context, raw string) error {
+	if a.contentPolicy == nil || a.contentPolicy.Mode != "selected" {
+		return nil
+	}
+	jid, err := types.ParseJID(raw)
+	if err != nil || jid.IsEmpty() {
+		return errContentSkipped
+	}
+	candidates := []types.JID{canonicalJID(jid)}
+	var resolver LocalResolver
+	if a.wa != nil {
+		resolver = a.wa
+	} else {
+		resolver, _ = a.ReadOnlyResolver()
+	}
+	if resolver != nil {
+		canonical := canonicalJID(resolver.ResolveLIDToPN(ctx, jid))
+		candidates = append(candidates, canonical)
+		if canonical.Server == types.DefaultUserServer {
+			candidates = append(candidates, canonicalJID(resolver.ResolvePNToLID(ctx, canonical)))
+		}
+	}
+	for _, candidate := range candidates {
+		if _, ok := a.contentPolicy.allowed[candidate.ToNonAD().String()]; ok {
+			return nil
+		}
+	}
+	return errContentSkipped
+}
