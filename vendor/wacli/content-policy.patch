+	}))
+	defer server.Close()
+	live := func(chat types.JID, id string) *events.Message {
+		return &events.Message{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: chat}, ID: id, Timestamp: time.Now()}, Message: &waProto.Message{Conversation: proto.String(id)}}
+	}
+	f.connectEvents = []any{live(excluded, "excluded-body"), &events.Receipt{MessageSource: types.MessageSource{Chat: excluded, Sender: excluded}, MessageIDs: []types.MessageID{"excluded-id"}, Type: types.ReceiptTypeRead, Timestamp: time.Now()}, &events.ChatPresence{MessageSource: types.MessageSource{Chat: excluded, Sender: excluded}, State: types.ChatPresenceComposing}, live(allowed, "allowed-sentinel")}
+	all, _ := ParseSyncWebhookEvents("message,receipt,chat_presence")
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	count := 0
+	_, err := a.Sync(ctx, SyncOptions{Mode: SyncModeFollow, WebhookURL: server.URL, WebhookAllowPrivate: true, WebhookEvents: all, AfterConnect: func(context.Context) error {
+		defer cancel()
+		for {
+			select {
+			case body := <-received:
+				count++
+				if strings.Contains(body, "excluded") || strings.Contains(body, "222") {
+					t.Errorf("excluded webhook emitted: %s", body)
+				}
+				if strings.Contains(body, "allowed-sentinel") {
+					return nil
+				}
+			case <-time.After(2 * time.Second):
+				return fmt.Errorf("allowed webhook did not arrive")
+			}
+		}
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 {
+		t.Fatalf("webhook count=%d want=1", count)
+	}
+}
+
+func TestContentPolicySkippedContentDoesNotFailSuccessfulSync(t *testing.T) {
+	a, f := policyTestApp(t, "selected", `[]`)
+	f.connectEvents = []any{historySyncWithTextMessages(types.NewJID("222", types.DefaultUserServer), time.Now(), "late")}
+	result, err := a.Sync(t.Context(), SyncOptions{Mode: SyncModeOnce, IdleExit: time.Millisecond, MaxMessages: 100})
+	if err != nil || result.MessagesStored != 0 {
+		t.Fatalf("skip failed sync: %+v %v", result, err)
+	}
+	last, err := a.DB().LastSuccessfulSync()
+	if err != nil || last == nil {
+		t.Fatalf("intentional skip was treated as persistence failure: %v %v", last, err)
+	}
+}
