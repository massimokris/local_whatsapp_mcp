@@ -0,0 +1,85 @@
+package app
+
+import (
+	"database/sql"
+	"github.com/openclaw/wacli/internal/store"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestSyncReceiptIgnoresEmptyMessageIDsWithoutLosingValidReceipts(t *testing.T) {
+	for _, ids := range [][]types.MessageID{{""}, {" "}, {"", "valid", " "}} {
+		t.Run("protocol-empty-id", func(t *testing.T) {
+			a, f, tracker, output := completionFixture(t)
+			completionReady(f)
+			chat := types.NewJID("15551234567", types.DefaultUserServer)
+			at := time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)
+			if err := a.db.UpsertChat(chat.String(), "dm", "Synthetic", at); err != nil {
+				t.Fatal(err)
+			}
+			if err := a.db.UpsertMessage(store.UpsertMessageParams{ChatJID: chat.String(), MsgID: "valid", Timestamp: at, FromMe: true, Text: "synthetic"}); err != nil {
+				t.Fatal(err)
+			}
+			f.emit(&events.Receipt{MessageSource: types.MessageSource{Chat: chat, Sender: chat}, MessageIDs: ids, Timestamp: at, Type: types.ReceiptTypeRead})
+			if state := completionState(t, tracker); state != "caught_up" {
+				t.Fatalf("protocol empty ID left sync=%s debtcount=%d warnings=%s", state, len(tracker.debts), output.String())
+			}
+			counts, err := a.db.MessageReceipts(chat.String(), "valid")
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected := 0
+			for _, id := range ids {
+				if id == "valid" {
+					expected = 1
+				}
+			}
+			if counts.Read != expected {
+				t.Fatalf("valid receipt count=%d want=%d", counts.Read, expected)
+			}
+		})
+	}
+}
+
+func TestSyncReceiptKeepsRealPersistenceFailureUntilSuccessfulReplay(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	chat := types.NewJID("15551234567", types.DefaultUserServer)
+	at := time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)
+	if err := a.db.UpsertChat(chat.String(), "dm", "Synthetic", at); err != nil {
+		t.Fatal(err)
+	}
+	if err := a.db.UpsertMessage(store.UpsertMessageParams{ChatJID: chat.String(), MsgID: "valid", Timestamp: at, FromMe: true, Text: "synthetic"}); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := sql.Open("sqlite3", filepath.Join(a.opts.StoreDir, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	if _, err = raw.Exec(`CREATE TRIGGER fail_receipt BEFORE INSERT ON message_receipts BEGIN SELECT RAISE(FAIL, 'synthetic receipt write failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	receipt := &events.Receipt{MessageSource: types.MessageSource{Chat: chat, Sender: chat}, MessageIDs: []types.MessageID{"", "valid"}, Timestamp: at, Type: types.ReceiptTypeRead}
+	f.emit(receipt)
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("failed write was forgiven: sync=%s", state)
+	}
+	if _, err = raw.Exec(`DROP TRIGGER fail_receipt`); err != nil {
+		t.Fatal(err)
+	}
+	f.emit(receipt)
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("verified replay left sync=%s", state)
+	}
+	counts, err := a.db.MessageReceipts(chat.String(), "valid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if counts.Read != 1 {
+		t.Fatalf("receipt not saved: %+v", counts)
+	}
+}
