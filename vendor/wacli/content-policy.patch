diff --git a/internal/app/sync_recovery_completion_test.go b/internal/app/sync_recovery_completion_test.go
new file mode 100644
index 0000000..e1ce8b6
--- /dev/null
+++ b/internal/app/sync_recovery_completion_test.go
@@ -0,0 +1,137 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func TestSyncCompletionStartupAppStateFailureRequiresSuccessfulRecovery(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	if err := a.db.SetChatArchiveSetting(false, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	f.mu.Lock()
+	f.appStateFetchErr = errors.New("synthetic app-state fetch failure")
+	f.mu.Unlock()
+	a.syncAppStateDeltas(t.Context(), &sync.Map{})
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("failed startup app-state fetch reported %s", state)
+	}
+	f.mu.Lock()
+	f.appStateFetchErr = nil
+	f.mu.Unlock()
+	a.syncAppStateDeltas(t.Context(), &sync.Map{})
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("successful same-collection retry reported %s", state)
+	}
+}
+
+func TestSyncCompletionAsyncAppStateRecoveryWaitsForPersistence(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	entered, release := make(chan struct{}), make(chan struct{})
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { close(entered); <-release; return nil, nil }
+	a.wa = client
+	a.handleAppStateSyncError(t.Context(), &events.AppStateSyncError{Name: appstate.WAPatchRegularLow, Error: appstate.ErrMismatchingLTHash}, &sync.Map{})
+	<-entered
+	state := completionState(t, tracker)
+	close(release)
+	a.appStateRecoveryWorkers.Wait()
+	if state != "syncing" {
+		t.Fatalf("pending asynchronous recovery reported %s", state)
+	}
+	if state = completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("persisted asynchronous recovery reported %s", state)
+	}
+}
+
+func TestSyncCompletionLateAppStateRecoveryRetainsErrorUntilSnapshotSaved(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	name := string(appstate.WAPatchRegularLow)
+	_, failed := tracker.begin(t.Context(), "app-state-recovery:"+name, "")
+	failed.finish(errors.New("synthetic earlier persistence failure"))
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { return nil, appstate.ErrMismatchingLTHash }
+	client.requestAppStateRecovery = func(context.Context, string) (types.MessageID, error) { return "synthetic-recovery", nil }
+	a.wa = client
+	if err := a.recoverAppStateCollection(t.Context(), name, &sync.Map{}, 10*time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("pending retry erased unrecovered failure: %s", state)
+	}
+	f.emit(&events.AppStateSyncComplete{Name: appstate.WAPatchRegularLow, Recovery: true})
+	a.appStateRecoveryWorkers.Wait()
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("late snapshot did not settle recovered collection: %s", state)
+	}
+}
+
+func TestSyncCompletionAppStateRecoveryFailureAndSameCollectionRetry(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) {
+		return nil, errors.New("synthetic fetch failure")
+	}
+	client.requestAppStateRecovery = func(context.Context, string) (types.MessageID, error) {
+		return "", errors.New("synthetic phone failure")
+	}
+	a.wa = client
+	name := string(appstate.WAPatchRegularLow)
+	if err := a.recoverAppStateCollection(t.Context(), name, &sync.Map{}, time.Second); err == nil {
+		t.Fatal("expected recovery failure")
+	}
+	if state := completionState(t, tracker); state != "error" {
+		t.Fatalf("failed recovery reported %s", state)
+	}
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { return nil, nil }
+	if err := a.recoverAppStateCollection(t.Context(), name, &sync.Map{}, time.Second); err != nil {
+		t.Fatal(err)
+	}
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("successful collection replay reported %s", state)
+	}
+}
+
+func TestSyncCompletionExpectedAppStateScopeSkipIsHarmless(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	if err := a.db.SetChatArchiveSetting(false, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	f.mu.Lock()
+	f.appStateFetchErr = errContentSkipped
+	f.mu.Unlock()
+	a.syncAppStateDeltas(t.Context(), &sync.Map{})
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("expected scope exclusion reported %s", state)
+	}
+}
+
+func TestSyncCompletionStartupMismatchRecoveredByAsyncFullReplay(t *testing.T) {
+	a, f, tracker, _ := completionFixture(t)
+	completionReady(f)
+	if err := a.db.SetChatArchiveSetting(false, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	client := &appStateContextWA{fakeWA: f}
+	client.fetchAppState = func(context.Context, string, bool, bool) error { return appstate.ErrMismatchingLTHash }
+	client.fetchEvents = func(context.Context, string, bool, bool) ([]any, error) { return nil, nil }
+	a.wa = client
+	a.syncAppStateDeltas(t.Context(), &sync.Map{})
+	a.appStateRecoveryWorkers.Wait()
+	if state := completionState(t, tracker); state != "caught_up" {
+		t.Fatalf("successful fallback retained original fetch failure: %s", state)
+	}
+}
diff --git a/internal/app/sync_snapshot_test.go b/internal/app/sync_snapshot_test.go
new file mode 100644
index 0000000..b79a0e4
--- /dev/null
+++ b/internal/app/sync_snapshot_test.go
@@ -0,0 +1,99 @@
+package app
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/openclaw/wacli/internal/out"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func TestSyncSnapshotCannotEraseANewerConnection(t *testing.T) {
+	a, _ := policyTestApp(t, "all", `[]`)
+	var output bytes.Buffer
+	a.opts.Events = out.NewEventWriter(&output, true)
+	tracker := &syncCompletion{app: a, runID: "fixture", revision: 1, connection: 1, connectionVersion: 1,
+		connected: true, boundary: true, debts: map[string]syncDebt{}, activeKeys: map[string]int{}}
+	started, release, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		tracker.snapshot(func() bool { close(started); <-release; return false })
+		close(done)
+	}()
+	<-started
+	tracker.receive(&events.DeliveryState{ConnectionID: 2, Boundary: true})
+	tracker.connectionEvent(2, true)
+	close(release)
+	<-done
+	tracker.mu.Lock()
+	state, connected := tracker.stateLocked(), tracker.connected
+	tracker.mu.Unlock()
+	if state != "caught_up" || !connected {
+		t.Fatalf("old health sample erased current connection: state=%s connected=%v", state, connected)
+	}
+	if strings.Contains(output.String(), `"event":"connection_check_failed"`) {
+		t.Fatalf("stale health check was published against new connection: %s", output.String())
+	}
+}
+
+func TestSyncSnapshotFailedCheckInvalidatesWithoutRestoringFromLiveness(t *testing.T) {
+	a, _ := policyTestApp(t, "all", `[]`)
+	var output bytes.Buffer
+	a.opts.Events = out.NewEventWriter(&output, true)
+	tracker := &syncCompletion{app: a, runID: "fixture", revision: 3, connection: 7, connectionVersion: 1,
+		connected: true, boundary: true, debts: map[string]syncDebt{}, activeKeys: map[string]int{}}
+	tracker.snapshot(func() bool { return false })
+	tracker.snapshot(func() bool { t.Fatal("disconnected snapshot performed a connection check"); return true })
+	tracker.mu.Lock()
+	state, boundary := tracker.stateLocked(), tracker.boundary
+	tracker.mu.Unlock()
+	if state != "unknown" || boundary {
+		t.Fatalf("failed check retained completion: %s boundary=%v", state, boundary)
+	}
+	var failedCheck bool
+	for _, line := range strings.Split(strings.TrimSpace(output.String()), "\n") {
+		var event struct {
+			Event string `json:"event"`
+			Data  struct {
+				RunID        string `json:"run_id"`
+				Revision     int64  `json:"revision"`
+				ConnectionID uint64 `json:"connection_id"`
+				State        string `json:"state"`
+			} `json:"data"`
+		}
+		if err := json.Unmarshal([]byte(line), &event); err != nil {
+			t.Fatal(err)
+		}
+		if event.Data.State == "caught_up" {
+			t.Fatalf("liveness restored completion: %s", line)
+		}
+		if event.Event == "connection_check_failed" {
+			failedCheck = event.Data.RunID == "fixture" && event.Data.Revision == 3 && event.Data.ConnectionID == 7
+		}
+	}
+	if !failedCheck {
+		t.Fatalf("failed health check omitted its connection identity: %s", output.String())
+	}
+}
+
+func TestSyncStartupExcludesUndecryptableWorkOutsideScope(t *testing.T) {
+	a, fake := policyTestApp(t, "selected", `["111@s.whatsapp.net"]`)
+	var output bytes.Buffer
+	a.opts.Events = out.NewEventWriter(&output, true)
+	excluded := types.NewJID("222", types.DefaultUserServer)
+	fake.connectEvents = []any{&events.Connected{DeliveryConnectionID: 1},
+		&events.UndecryptableMessage{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: excluded}, ID: "excluded"}},
+		&events.DeliveryState{ConnectionID: 1, Boundary: true}}
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	_, err := a.Sync(ctx, SyncOptions{Mode: SyncModeFollow, AfterConnect: func(context.Context) error { cancel(); return nil }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(output.String(), `"state":"error"`) || !strings.Contains(output.String(), `"state":"caught_up"`) {
+		t.Fatalf("excluded work blocked startup catch-up: %s", output.String())
+	}
+}
