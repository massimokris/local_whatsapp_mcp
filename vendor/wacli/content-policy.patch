+// DiscardRevokedSession finishes the SDK's local device cleanup when shutdown
+// interrupted a confirmed remote logout. The caller must own the writer lock
+// and have explicit relinking intent plus persisted revocation evidence. The
+// archive and recovery journal are separate stores and remain untouched.
+func DiscardRevokedSession(ctx context.Context, storePath string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	container, err := sqlstore.New(ctx, "sqlite3", sqliteutil.FileURI(storePath, "_foreign_keys=on"), nil)
+	if err != nil {
+		return fmt.Errorf("open revoked WhatsApp session: %w", err)
+	}
+	defer container.Close()
+	device, err := container.GetFirstDevice(ctx)
+	if err != nil {
+		return fmt.Errorf("read revoked WhatsApp session: %w", err)
+	}
+	if device.ID != nil {
+		if err := device.Delete(ctx); err != nil {
+			return fmt.Errorf("discard revoked WhatsApp session: %w", err)
+		}
+	}
+	return nil
+}
