# Use the same server-only DATABASE_URL as the keyboard landing.
# It writes to public.waitlist_signups and appends missing sources on repeat signups.
# Restricted writers need db/append-source-permissions.sql applied before deployment.
# Source is set on the server to landing_localwhatsappmcp.
DATABASE_URL=

# Optional public origin, including https://, for social preview image URLs.
# Defaults to Vercel's production domain, then deployment domain, or localhost.
SITE_URL=
